{
  "pages": [
    "pages/login/login",
    "pages/index/index",
    "pages/map/map",
    "pages/favorite/favorite",
    "pages/profile/profile"
  ],
  "subpackages": [
    {
      "root": "pagesVendor",
      "name": "vendor",
      "pages": [
        "vendor/vendor",
        "vendor-edit/vendor-edit",
        "apply-vendor/apply-vendor",
        "product-manage/product-manage",
        "product-form/product-form"
      ]
    },
    {
      "root": "pagesReview",
      "name": "review",
      "pages": [
        "review-list/review-list",
        "my-reviews/my-reviews",
        "add-review/add-review"
      ]
    },
    {
      "root": "pagesOther",
      "name": "other",
      "pages": [
        "hot-ranking/hot-ranking",
        "vendor-detail/vendor-detail",
        "edit-phone/edit-phone",
        "agreement/agreement"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pagesOther"]
    },
    "pages/profile/profile": {
      "network": "wifi",
      "packages": ["pagesVendor", "pagesReview"]
    }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#FFB300",
    "navigationBarTitleText": "地摊地图",
    "navigationBarTextStyle": "white"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#FFB300",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/icons/tab-home.png",
        "selectedIconPath": "assets/icons/tab-home-active.png"
      },
      {
        "pagePath": "pages/map/map",
        "text": "地图",
        "iconPath": "assets/icons/tab-map.png",
        "selectedIconPath": "assets/icons/tab-map-active.png"
      },
      {
        "pagePath": "pages/favorite/favorite",
        "text": "收藏",
        "iconPath": "assets/icons/tab-fav.png",
        "selectedIconPath": "assets/icons/tab-fav-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "assets/icons/tab-profile.png",
        "selectedIconPath": "assets/icons/tab-profile-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ],
  "permission": {
    "scope.userLocation": {
      "desc": "需要您的位置信息来显示附近摊位"
    }
  },
  "__usePrivacyCheck__": true
}
