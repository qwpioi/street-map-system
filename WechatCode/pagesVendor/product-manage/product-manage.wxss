page {
  background-color: #f5f5f5;
}

.pm-page {
  width: 100%;
  min-height: 100vh;
  padding: 0 var(--space-lg) var(--space-xl);
  box-sizing: border-box;
}

/* 头部 */
.pm-header {
  padding: var(--space-lg) 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pm-title {
  font-size: var(--font-size-xl);
  font-weight: bold;
  color: #333;
}

.pm-add-btn {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  background: var(--color-primary);
  color: #fff;
  padding: var(--space-xs) var(--space-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 179, 0, 0.3);
  transition: all 0.2s;
}

.hover-add-btn {
  background: var(--color-primary-dark);
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 0, 0.4);
}

/* 列表 */
.pm-list {
  margin-top: var(--space-sm);
}

.pm-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  transition: all 0.2s;
}

.pm-card-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

.pm-img-wrap {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  background: #f5f5f5;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.pm-img {
  width: 100%;
  height: 100%;
}

.pm-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.pm-info {
  flex: 1;
  margin-left: var(--space-md);
  margin-right: var(--space-md);
  min-width: 0;
}

.pm-name {
  font-size: var(--font-size-lg);
  font-weight: bold;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pm-desc {
  font-size: var(--font-size-sm);
  color: #999;
  display: block;
  margin-top: var(--space-xs);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pm-bottom {
  display: flex;
  align-items: center;
  margin-top: var(--space-sm);
}

.pm-price {
  font-size: var(--font-size-xl);
  color: #ff6b00;
  font-weight: bold;
}

.pm-tag {
  font-size: var(--font-size-xs);
  padding: 4rpx var(--space-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  margin-left: var(--space-sm);
}

/* 操作按钮 */
.pm-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.pm-edit,
.pm-delete {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.pm-edit {
  background: rgba(255, 179, 0, 0.1);
}

.hover-edit {
  background: rgba(255, 179, 0, 0.2);
  transform: scale(1.1);
}

.pm-delete {
  background: rgba(231, 76, 60, 0.1);
}

.hover-delete {
  background: rgba(231, 76, 60, 0.2);
  transform: scale(1.1);
}
