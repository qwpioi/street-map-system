<view class="pm-page">
  <!-- 头部 -->
  <view class="pm-header">
    <text class="pm-title">商品管理</text>
    <view class="pm-add-btn" bindtap="onAdd" hover-class="hover-add-btn">
      <icon name="check" size="xs" color="#fff"></icon>
      <text>添加</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="pm-list" wx:if="{{products.length > 0}}">
    <view class="pm-card" wx:for="{{products}}" wx:key="id" hover-class="pm-card-hover">
      <view class="pm-img-wrap">
        <image class="pm-img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
        <view wx:if="{{!item.imageUrl}}" class="pm-placeholder">
          <icon name="food" size="xl" color="#ccc"></icon>
        </view>
      </view>
      <view class="pm-info">
        <text class="pm-name">{{item.name}}</text>
        <text class="pm-desc" wx:if="{{item.description && item.description.indexOf('') === -1}}">{{item.description}}</text>
        <view class="pm-bottom">
          <text class="pm-price">¥{{item.price}}</text>
          <text class="pm-tag">{{item.status == 1 ? '上架' : '下架'}}</text>
        </view>
      </view>
      <view class="pm-actions">
        <view class="pm-edit" bindtap="onEdit" data-id="{{item.id}}" hover-class="hover-edit">
          <icon name="edit" size="xs" color="#FFB300"></icon>
        </view>
        <view class="pm-delete" bindtap="onDelete" data-id="{{item.id}}" data-name="{{item.name}}" hover-class="hover-delete">
          <icon name="close" size="xs" color="#e74c3c"></icon>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:if="{{!loading && products.length === 0}}"
    icon="📦"
    text="还没有商品"
    buttonText="+ 添加商品"
    bind:action="onAdd"
  ></empty-state>
</view>
