page {
  background-color: var(--color-bg-page, #f5f5f5);
}

.container {
  padding: var(--space-lg, 30rpx);
}

.form-group {
  background-color: var(--color-bg-card, #fff);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-md, 24rpx);
  margin-bottom: var(--space-md, 20rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.label {
  display: block;
  font-size: var(--font-size-base, 28rpx);
  color: var(--color-text-primary, #333);
  font-weight: 600;
  margin-bottom: var(--space-sm, 16rpx);
}

.input {
  width: 100%;
  font-size: var(--font-size-base, 28rpx);
  padding: var(--space-sm, 16rpx) var(--space-md, 20rpx);
  background-color: var(--color-bg-input, #f9f9f9);
  border-radius: var(--radius-md, 12rpx);
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.input-focus {
  border-color: var(--color-primary, #07C160);
  background-color: #fff;
}

.textarea {
  width: 100%;
  font-size: var(--font-size-base, 28rpx);
  padding: var(--space-sm, 16rpx) var(--space-md, 20rpx);
  background-color: var(--color-bg-input, #f9f9f9);
  border-radius: var(--radius-md, 12rpx);
  border: 2rpx solid transparent;
  box-sizing: border-box;
  min-height: 120rpx;
  transition: border-color 0.2s ease;
}

.textarea-focus {
  border-color: var(--color-primary, #07C160);
  background-color: #fff;
}

.hint {
  display: block;
  margin-top: var(--space-xs, 12rpx);
  font-size: var(--font-size-xs, 22rpx);
  color: var(--color-text-light, #bbb);
}

.actions {
  margin-top: var(--space-xl, 40rpx);
  display: flex;
  flex-direction: column;
  gap: var(--space-md, 20rpx);
}

.btn-submit {
  background-color: var(--color-primary, #07C160);
  color: #fff;
  border-radius: var(--radius-pill, 30rpx);
  font-size: var(--font-size-lg, 30rpx);
  padding: var(--space-md, 20rpx);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  transition: all 0.2s ease;
}

.btn-submit-hover {
  opacity: 0.85;
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}

.btn-cancel {
  background-color: var(--color-bg-card, #fff);
  color: var(--color-text-secondary, #999);
  border: 2rpx solid var(--color-border, #ddd);
  border-radius: var(--radius-pill, 30rpx);
  font-size: var(--font-size-lg, 30rpx);
  padding: var(--space-md, 20rpx);
  transition: all 0.2s ease;
}

.btn-cancel-hover {
  background-color: var(--color-bg-page, #f5f5f5);
  opacity: 0.8;
}

/* 图片选择按钮 */
.image-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  border: 2rpx dashed var(--color-border, #ddd);
  border-radius: var(--radius-lg, 16rpx);
  background: var(--color-bg-input, #fafafa);
  transition: all 0.2s ease;
}

.image-picker-hover {
  border-color: var(--color-primary, #07C160);
  background-color: rgba(7, 193, 96, 0.05);
  transform: scale(0.98);
}

.picker-text {
  font-size: var(--font-size-sm, 26rpx);
  color: var(--color-text-light, #999);
  margin-top: var(--space-xs, 10rpx);
}

/* 图片预览 */
.image-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 var(--radius-lg, 16rpx) 0 var(--radius-lg, 16rpx);
  transition: background 0.2s ease;
}

.remove-btn-hover {
  background: rgba(0, 0, 0, 0.8);
}
