<view class="container">
  <form bindsubmit="onSubmit">
    <view class="form-group">
      <text class="label">商品名称 *</text>
      <input 
        class="input" 
        name="name" 
        value="{{formData.name}}" 
        placeholder="例如：招牌炒饭" 
        maxlength="50"
      />
    </view>

    <view class="form-group">
      <text class="label">商品描述</text>
      <textarea 
        class="textarea" 
        name="description" 
        value="{{formData.description}}" 
        placeholder="例如：蛋炒饭、扬州炒饭、蛋炒粉" 
        maxlength="200"
        auto-height
      />
    </view>

    <view class="form-group">
      <text class="label">价格（元）*</text>
      <input 
        class="input" 
        name="price" 
        value="{{formData.price}}" 
        placeholder="例如：12" 
        type="digit"
      />
    </view>

    <!-- 图片上传区域 -->
    <view class="form-group">
      <text class="label">商品图片</text>

      <!-- 未选择时：显示选图按钮 -->
      <view wx:if="{{!imageTempPath}}" class="image-picker" bindtap="onChooseImage">
        <text class="picker-icon">📷</text>
        <text class="picker-text">点击选择图片</text>
      </view>

      <!-- 已选择时：显示预览 + 移除按钮 -->
      <view wx:else class="image-preview">
        <image class="preview-img" src="{{imageTempPath}}" mode="aspectFill" />
        <view class="remove-btn" bindtap="onRemoveImage">✕</view>
      </view>

      <text class="hint">支持 jpg、png、gif、webp 格式，最大 5MB</text>
    </view>

    <view class="actions">
      <button class="btn-submit" formType="submit" disabled="{{uploading}}">
        {{uploading ? '上传中...' : (isEdit ? '保存修改' : '发布商品')}}
      </button>
      <button class="btn-cancel" bindtap="onCancel">取消</button>
    </view>
  </form>
</view>
