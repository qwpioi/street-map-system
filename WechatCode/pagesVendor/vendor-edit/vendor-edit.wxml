<view class="container">
  <!-- 头像区域 -->
  <view class="form-group">
    <view class="label-row">
      <icon name="shop" size="sm" color="var(--color-primary)"></icon>
      <text class="label">摊位头像</text>
    </view>
    <view class="avatar-wrapper" bindtap="onChooseAvatar">
      <view wx:if="{{!avatar}}" class="image-picker" hover-class="hover-picker">
        <icon name="edit" size="xl" color="#ccc"></icon>
        <text class="picker-text">点击上传头像</text>
      </view>
      <view wx:else class="image-preview">
        <image class="preview-img" src="{{avatar}}" mode="aspectFill" />
        <view class="remove-btn" catchtap="onRemoveAvatar" hover-class="hover-remove">
          <icon name="close" size="xs" color="#fff"></icon>
        </view>
      </view>
    </view>
  </view>

  <!-- 摊位名称 -->
  <view class="form-group">
    <view class="label-row">
      <icon name="shop" size="sm" color="var(--color-primary)"></icon>
      <text class="label">摊位名称</text>
      <text class="required">*</text>
    </view>
    <input
      class="input {{focusName ? 'input-focus' : ''}}"
      value="{{stallName}}"
      placeholder="请输入摊位名称"
      maxlength="20"
      bindinput="onInputName"
      bindfocus="onFocusName"
      bindblur="onBlurName"
    />
  </view>

  <!-- 联系电话 -->
  <view class="form-group">
    <view class="label-row">
      <icon name="phone" size="sm" color="var(--color-primary)"></icon>
      <text class="label">联系电话</text>
    </view>
    <input
      class="input {{focusPhone ? 'input-focus' : ''}}"
      value="{{phone}}"
      type="number"
      placeholder="请输入手机号"
      maxlength="11"
      bindinput="onInputPhone"
      bindfocus="onFocusPhone"
      bindblur="onBlurPhone"
    />
  </view>

  <!-- 保存按钮 -->
  <view class="actions">
    <button class="btn-submit" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}" hover-class="hover-submit">
      <icon name="check" size="sm" color="#fff"></icon>
      <text>{{saving ? '保存中...' : '保存'}}</text>
    </button>
    <button class="btn-cancel" bindtap="onCancel" hover-class="hover-cancel">取消</button>
  </view>
</view>
