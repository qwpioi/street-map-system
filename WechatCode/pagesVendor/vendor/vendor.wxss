.vendor-page {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0 var(--space-sm) var(--space-xl);
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  margin: 0;
}

/* 摊位头部卡片 */
.vendor-stall-card {
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  color: white;
  margin-top: var(--space-sm);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
}

.stall-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.stall-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  margin-right: var(--space-md);
}

.stall-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.stall-name {
  font-size: var(--font-size-xl);
  font-weight: bold;
}

.stall-address {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  font-size: var(--font-size-sm);
  opacity: 0.9;
}

.address-text {
  font-size: var(--font-size-sm);
}

/* 统计卡片 */
.vendor-stat-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: var(--space-lg) var(--space-md);
  margin-bottom: var(--space-md);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.vendor-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
}

.vendor-stat-num {
  font-size: var(--font-size-lg);
  font-weight: bold;
  color: #666;
  white-space: nowrap;
}

.vendor-stat-rating {
  color: var(--color-primary);
}

.vendor-stat-label {
  font-size: var(--font-size-xs);
  color: #999;
  white-space: nowrap;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #f0f0f0;
}

/* 摊位信息卡片 */
.vendor-info-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:first-of-type {
  padding-top: 0;
}

.info-label-row {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  width: 160rpx;
  flex-shrink: 0;
}

.info-label {
  font-size: var(--font-size-md);
  color: #999;
}

.info-value {
  flex: 1;
  font-size: var(--font-size-md);
  color: #333;
}

.info-value.phone {
  color: var(--color-primary);
  font-weight: bold;
}

.edit-info-btn {
  margin-top: var(--space-md);
  background: var(--color-primary) !important;
  color: white !important;
  font-size: var(--font-size-md);
  border-radius: var(--radius-full);
  border: none !important;
  height: 80rpx;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  box-shadow: 0 4rpx 16rpx rgba(255, 179, 0, 0.3);
  transition: all 0.2s;
}

.hover-edit-btn {
  background: var(--color-primary-dark) !important;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 0, 0.4);
}

.edit-info-btn::after {
  border: none;
}

/* 操作卡片 */
.vendor-operate-box {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.operate-status {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.operate-label {
  font-size: var(--font-size-md);
  color: #333;
}

.vendor-operate-box switch {
  transform: scale(1.2);
}

.vendor-manage-btn {
  background: var(--color-primary) !important;
  color: white !important;
  padding: 0 var(--space-xl);
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 600;
  border: none !important;
  box-shadow: 0 4rpx 16rpx rgba(255, 179, 0, 0.3);
  margin: 0;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  transition: all 0.2s;
}

.hover-manage-btn {
  background: var(--color-primary-dark) !important;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 0, 0.4);
}

.vendor-manage-btn::after {
  border: none;
}

/* 商品列表 */
.vendor-section-title {
  font-size: var(--font-size-lg);
  font-weight: bold;
  margin-bottom: var(--space-md);
  padding-left: var(--space-xs);
  color: #333;
}

.vendor-goods-item {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  transition: all 0.2s;
}

.hover-goods-item {
  background-color: #f9f9f9;
  transform: scale(0.98);
}

.vendor-goods-img {
  width: 120rpx;
  height: 120rpx;
  background: #f5f5f5;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vendor-goods-img image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.vendor-goods-info {
  flex: 1;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.vendor-goods-name {
  font-size: var(--font-size-lg);
  font-weight: bold;
  color: #333;
}

.vendor-goods-price-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--space-sm);
}

.vendor-goods-price {
  font-size: var(--font-size-xl);
  color: #ff6b00;
  font-weight: bold;
}

.vendor-goods-tag {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 500;
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  white-space: nowrap;
}
