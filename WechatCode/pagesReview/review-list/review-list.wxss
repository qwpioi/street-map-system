/* 页面容器（隐藏原页面内容） */
page {
  background-color: transparent;
}

/* 背景遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* 半屏弹窗容器 */
.review-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 65vh;
  display: flex;
  flex-direction: column;
  pointer-events: none;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
}

.review-modal.show {
  transform: translateY(0);
  pointer-events: auto;
}

/* 顶部拖动条 */
.modal-drag-bar {
  padding: var(--space-md);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.drag-indicator {
  width: 80rpx;
  height: 8rpx;
  background-color: #e0e0e0;
  border-radius: var(--radius-sm);
}

/* 标题栏 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  padding: var(--space-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  transition: background-color 0.2s;
}

.hover-close {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 平均评分 */
.modal-average {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-lg);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  flex-shrink: 0;
}

.average-score {
  font-size: 80rpx;
  font-weight: bold;
  line-height: 1;
}

.average-text {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: var(--space-xs);
}

/* 评价列表滚动区域 */
.review-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0;
}

.review-list {
  min-height: 300rpx;
  padding: var(--space-sm) 0;
}

.review-item {
  padding: var(--space-lg);
  margin: 0 var(--space-sm) var(--space-sm) var(--space-sm);
  background-color: #fff;
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.hover-review-item {
  background-color: #f9f9f9;
  transform: scale(0.98);
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.review-user {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.review-header-right {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.delete-btn {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  transition: background-color 0.2s;
  display: flex;
  align-items: center;
}

.hover-delete {
  background-color: rgba(231, 76, 60, 0.1);
}

.review-rating {
  margin-bottom: var(--space-sm);
}

.review-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部按钮 */
.modal-footer {
  padding: var(--space-lg);
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.add-review-btn {
  width: 100%;
  background-color: var(--color-primary) !important;
  color: #fff !important;
  font-size: 28rpx;
  padding: var(--space-md) 0;
  border-radius: var(--radius-full);
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  box-shadow: 0 4rpx 16rpx rgba(255, 179, 0, 0.3);
  transition: all 0.2s;
}

.hover-btn {
  background-color: var(--color-primary-dark) !important;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 0, 0.4);
}

.add-review-btn::after {
  border: none;
}

.btn-text {
  font-size: 28rpx;
  color: #fff;
}
