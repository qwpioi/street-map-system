<view class="add-review-container">
  <!-- 摊位信息 -->
  <view wx:if="{{vendorName}}" class="vendor-info">
    <icon name="shop" size="md" color="{{'var(--color-primary)'}}" />
    <text class="vendor-label">评价摊位：</text>
    <text class="vendor-name">{{vendorName}}</text>
  </view>

  <!-- 评分 -->
  <view class="rating-section">
    <text class="section-title">
      <icon name="star" size="sm" color="var(--color-warning)" /> 评分
    </text>
    <view class="rating-wrapper">
      <rating-stars
        rating="{{rating}}"
        max="5"
        size="lg"
        readonly="{{false}}"
        bind:change="onRatingChange"
      />
      <text class="rating-text">{{rating}}星</text>
    </view>
  </view>

  <!-- 评价内容 -->
  <view class="content-section">
    <text class="section-title">
      <icon name="edit" size="sm" color="var(--color-text-secondary)" /> 评价内容
    </text>
    <textarea
      class="content-input"
      placeholder="分享您的用餐体验..."
      maxlength="500"
      value="{{content}}"
      bindinput="onContentInput"
    ></textarea>
    <text class="char-count">{{content.length}}/500</text>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" bindtap="onSubmit" disabled="{{!rating || !content}}">提交评价</button>
</view>
