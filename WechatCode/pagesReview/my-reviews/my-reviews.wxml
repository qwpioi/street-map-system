<view class="my-reviews-container">

  <!-- 加载状态 -->
  <empty-state
    wx:if="{{loading}}"
    icon="⏳"
    text="加载中..."
  ></empty-state>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!loading && reviews.length === 0}}"
    icon="💬"
    text="暂无评价"
    desc="去逛逛摊位，留下你的评价吧"
    buttonText="去逛逛"
    bind:action="goHome"
  ></empty-state>

  <!-- 数据态 -->
  <view wx:else>

    <!-- 统计卡片 -->
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{stats.totalCount}}</text>
        <text class="stat-label">总评价数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.averageRating}}</text>
        <text class="stat-label">平均评分</text>
        <rating-stars rating="{{stats.averageRating}}" size="sm" readonly="{{true}}"></rating-stars>
      </view>
    </view>

    <!-- 评价列表 -->
    <view class="review-list">
      <view
        class="review-card"
        wx:for="{{reviews}}"
        wx:key="id"
        data-vendor-id="{{item.vendorId}}"
        bindtap="onReviewTap"
        hover-class="hover-review-card"
      >
        <view class="card-header">
          <text class="vendor-name">{{item.vendorName}}</text>
          <icon name="arrow-right" size="sm" color="#ccc"></icon>
          <view
            class="delete-btn"
            catchtap="deleteReview"
            data-review-id="{{item.id}}"
            hover-class="hover-delete"
          >
            <icon name="close" size="xs" color="#e74c3c"></icon>
          </view>
        </view>
        <view class="card-rating">
          <rating-stars rating="{{item.rating}}" size="sm" readonly="{{true}}"></rating-stars>
        </view>
        <text class="card-content" wx:if="{{item.content}}">{{item.content}}</text>
        <view class="card-footer">
          <text class="card-time">{{item.createTime}}</text>
        </view>
      </view>
    </view>

  </view>

</view>
