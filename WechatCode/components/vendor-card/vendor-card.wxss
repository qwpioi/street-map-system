/* 摊位卡片组件 */
.vendor-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.vendor-card.hover-scale {
  transform: scale(0.98);
}

/* 排名徽章 */
.rank-badge {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  margin-right: var(--space-md);
  flex-shrink: 0;
  border-radius: var(--radius-md);
}

.rank-badge.rank-top {
  background: linear-gradient(135deg, var(--color-primary), var(--color-warning));
  font-size: 50rpx;
  box-shadow: var(--shadow-md);
}

.rank-badge.rank-normal {
  background: var(--color-divider);
  color: var(--color-text-tertiary);
  font-size: 32rpx;
}

/* 缩略图 */
.card-thumb {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  flex-shrink: 0;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
}

/* 卡片内容 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 20rpx 20rpx 0;
  min-width: 0;
}

/* 顶部 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-fav-btn {
  padding: 8rpx;
  margin-left: 8rpx;
}

/* 评分行 */
.card-rating {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.rating-score {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFB300;
  margin-left: 8rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #999999;
  margin-left: 4rpx;
}

.rating-empty {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 标签行 */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.tag-item {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #FFF3E0;
  color: #FF6633;
  margin-right: 8rpx;
}

/* 底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.footer-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.footer-address {
  font-size: 22rpx;
  color: #999999;
  margin-left: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footer-distance {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: 600;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.footer-actions {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.action-btn.nav-btn {
  background: #E8F5E9;
}
