<!-- 空状态组件 -->
<view class="empty-state">
  <text wx:if="{{icon}}" class="empty-icon">{{icon}}</text>
  <text class="empty-text">{{text}}</text>
  <text wx:if="{{desc}}" class="empty-desc">{{desc}}</text>
  
  <button wx:if="{{buttonText}}" class="empty-btn" bindtap="onAction">
    {{buttonText}}
  </button>
</view>
