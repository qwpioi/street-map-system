.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.status-badge.size-sm {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
}

.status-badge.size-md {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
}

.status-badge.status-open {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-badge.status-closed {
  background: #F5F5F5;
  color: #999999;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 6rpx;
}

.status-text {
  line-height: 1;
}
