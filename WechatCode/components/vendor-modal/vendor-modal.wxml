<!-- 摊位详情弹窗组件 -->
<view class="vendor-detail-modal" wx:if="{{visible && vendor}}">
  <!-- 遮罩层 -->
  <view class="modal-mask" bindtap="onMaskTap"></view>
  
  <!-- 弹窗内容区 -->
  <view class="modal-content">
    <!-- 关闭按钮 -->
    <view class="close-btn" bindtap="onClose">
      <icon name="close" size="md" color="#666" />
    </view>

    <!-- 摊位信息头部 -->
    <view class="detail-header" bindtap="onViewVendor">
      <view class="detail-avatar">
        <icon name="food" size="xl" color="#FF6633" />
      </view>
      <view class="detail-info">
        <view class="detail-name">
          <text class="name-text">{{vendor.stallName}}</text>
          <text class="name-arrow">›</text>
        </view>
        <view class="detail-rating" wx:if="{{averageRating > 0}}">
          <view class="detail-rating-badge">
            <icon name="star" size="xs" color="#FFD100" />
            <text class="detail-score">{{averageRating}}</text>
          </view>
          <text class="review-count">{{reviewCount}}条评价</text>
        </view>
        <view class="detail-rating" wx:else>
          <text class="no-rating">暂无评分</text>
        </view>
        <view class="modal-favorite-wrapper" catchtap="onToggleFavorite">
          <icon name="{{vendor.isFavorite ? 'heart-filled' : 'heart'}}" size="sm" color="{{vendor.isFavorite ? '#F44336' : '#999'}}" />
          <text class="modal-favorite-text">{{vendor.isFavorite ? '已收藏' : '点击收藏'}}</text>
        </view>
      </view>
    </view>

    <!-- 信息网格 -->
    <view class="detail-body">
      <view class="detail-info-grid">
        <view class="detail-info-cell" wx:if="{{vendor.address}}">
          <icon name="location" size="xs" color="#999" />
          <text class="dic-val">{{vendor.address}}</text>
        </view>
        <view class="detail-info-cell" wx:if="{{vendor.distanceText || vendor.distance}}">
          <icon name="distance" size="xs" color="#4CAF50" />
          <text class="dic-val distance-val">{{vendor.distanceText || vendor.distance}}</text>
        </view>
        <view class="detail-info-cell" wx:if="{{vendor.phone}}" bindtap="onCallPhone">
          <icon name="phone" size="xs" color="#FF6633" />
          <text class="dic-val phone-val">{{vendor.phone}}</text>
        </view>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="modal-section" wx:if="{{products.length > 0 || vendor.products.length > 0}}">
      <view class="modal-section-title">
        <icon name="food" size="sm" color="#FF6633" />
        <text class="section-title-text">全部商品</text>
        <text class="modal-badge">{{products.length || vendor.products.length}}</text>
      </view>
      <view class="modal-product-list">
        <block wx:for="{{products.length > 0 ? products : vendor.products}}" wx:key="id" wx:if="{{index < 5}}">
          <view class="modal-product-card">
            <image class="modal-product-img" src="{{item.imageUrl || '/images/product-placeholder.svg'}}" mode="aspectFill" lazy-load />
            <view class="modal-product-info">
              <text class="modal-product-name">{{item.name}}</text>
              <text class="modal-product-desc" wx:if="{{item.description}}">{{item.description}}</text>
              <view class="modal-product-price">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{item.price}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 评价列表 -->
    <view class="modal-section" wx:if="{{reviews.length > 0}}">
      <view class="modal-section-header">
        <view class="modal-section-title">
          <icon name="review" size="sm" color="#4CAF50" />
          <text class="section-title-text">最新评价</text>
        </view>
        <text class="view-all" bindtap="onViewAllReviews">查看全部 ›</text>
      </view>
      <view class="modal-review-list">
        <view class="modal-review-item" wx:for="{{reviews}}" wx:key="id">
          <view class="modal-review-top">
            <image class="modal-review-avatar" src="{{item.userAvatar || '/images/avatar-placeholder.svg'}}" mode="aspectFill" lazy-load />
            <text class="modal-review-user">{{item.userName || '匿名用户'}}</text>
            <view class="modal-review-stars">
              <text wx:for="{{stars}}" wx:for-item="star" wx:key="*this" wx:if="{{star <= item.rating}}" class="star-filled">★</text>
              <text wx:for="{{stars}}" wx:for-item="star" wx:key="*this" wx:if="{{star > item.rating}}" class="star-empty">☆</text>
            </view>
            <text class="modal-review-time">{{item.createTime}}</text>
          </view>
          <view class="modal-review-content" wx:if="{{item.content}}">{{item.content}}</view>
        </view>
      </view>
    </view>

    <!-- 空评价状态 -->
    <view class="empty-reviews" wx:if="{{reviews.length === 0}}">
      <icon name="review" size="xl" color="#CCC" />
      <text class="empty-text">暂无评价，快来成为第一个评价的人吧！</text>
    </view>

    <!-- 底部操作栏 -->
    <view class="modal-actions">
      <button class="modal-action-btn secondary" bindtap="onReview">
        <icon name="edit" size="sm" color="#FF6633" />
        <text>发表评价</text>
      </button>
      <button class="modal-action-btn primary" catchtap="onNavigate">
        <icon name="nav" size="sm" color="#1A1A1A" />
        <text>导航前往</text>
      </button>
    </view>
  </view>
</view>
