<view class="page-container" wx:if="{{!loading && vendor}}">

  <!-- 黄色渐变头部 -->
  <view class="vd-header">
    <view class="vd-back-row">
      <status-badge status="{{vendor.status}}" />
    </view>

    <!-- 摊位信息卡片 -->
    <view class="vd-shop-card">
      <view class="vd-shop-top">
        <view class="vd-avatar">🍜</view>
        <view class="vd-shop-info">
          <view class="vd-shop-name">{{vendor.stallName}}</view>
          <view class="vd-shop-meta">
            <view class="vd-rating-badge" wx:if="{{averageRating > 0}}">
              <rating-stars rating="{{averageRating}}" size="small" />
              <text class="vd-score">{{averageRating.toFixed(1)}}</text>
            </view>
            <text class="vd-review-link" bindtap="viewAllReviews">{{reviewCount}}条评价</text>
          </view>
        </view>
        <view class="vd-fav-icon" bindtap="toggleFavorite">
          <icon name="{{isFavorite ? 'heart' : 'heart-outline'}}" size="44rpx" color="{{isFavorite ? '#FF4444' : '#CCCCCC'}}" />
        </view>
      </view>

      <!-- 信息网格 -->
      <view class="vd-info-grid">
        <view class="vd-info-cell" wx:if="{{vendor.address}}">
          <icon name="location" size="28rpx" color="#FF6633" />
          <text class="vd-iv">{{vendor.address}}</text>
        </view>
        <view class="vd-info-cell" wx:if="{{vendor.phone}}" bindtap="callPhone">
          <icon name="phone" size="28rpx" color="#FF6633" />
          <text class="vd-iv phone-val">{{vendor.phone}}</text>
        </view>
        <view class="vd-info-cell full" wx:if="{{vendor.hotProductsArray.length > 0}}">
          <icon name="fire" size="28rpx" color="#FF6633" />
          <view class="vd-tags">
            <text class="vd-tag" wx:for="{{vendor.hotProductsArray}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="vd-section" wx:if="{{products.length > 0}}">
    <view class="vd-section-title">
      <icon name="food" size="32rpx" color="#1A1A1A" />
      <text class="vd-title-text">全部商品</text>
      <text class="vd-badge">{{products.length}}</text>
    </view>
    <view class="vd-product-list">
      <view class="vd-product" wx:for="{{products}}" wx:key="id">
        <image class="vd-product-img" src="{{item.imageUrl || 'https://via.placeholder.com/100'}}" mode="aspectFill" />
        <view class="vd-product-info">
          <view>
            <text class="vd-product-name">{{item.name}}</text>
            <text class="vd-product-desc" wx:if="{{item.description}}">{{item.description}}</text>
          </view>
          <view class="vd-product-bottom">
            <text class="vd-product-price"><text class="vd-yen">¥</text>{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="vd-section vd-empty" wx:else>
    <text class="vd-empty-text">暂无上架商品</text>
  </view>

  <!-- 评价列表 -->
  <view class="vd-section" wx:if="{{reviews.length > 0}}">
    <view class="vd-section-header">
      <view class="vd-section-title">
        <icon name="chat" size="32rpx" color="#1A1A1A" />
        <text class="vd-title-text">最新评价</text>
      </view>
      <text class="vd-more" bindtap="viewAllReviews" wx:if="{{reviewCount > 5}}">查看全部 ›</text>
    </view>
    <view class="vd-review-list">
      <view class="vd-review" wx:for="{{reviews}}" wx:key="id">
        <view class="vd-review-top">
          <image class="vd-review-avatar" src="{{item.userAvatar || 'https://via.placeholder.com/50'}}" mode="aspectFill" />
          <text class="vd-review-user">{{item.userName || '匿名用户'}}</text>
          <rating-stars rating="{{item.rating}}" size="small" />
          <text class="vd-review-time">{{item.createTime}}</text>
        </view>
        <text class="vd-review-text" wx:if="{{item.content}}">{{item.content}}</text>
      </view>
    </view>
  </view>
  <view class="vd-section vd-empty" wx:else>
    <text class="vd-empty-text">暂无评价，快来成为第一个评价的人吧！</text>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-spacer"></view>

  <!-- 底部操作栏 -->
  <bottom-action-bar
    bind:callPhone="callPhone"
    bind:toggleFavorite="toggleFavorite"
    bind:review="addReview"
    bind:navigate="navigateTo"
    isFavorite="{{isFavorite}}"
  />

</view>

<!-- 加载状态 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
