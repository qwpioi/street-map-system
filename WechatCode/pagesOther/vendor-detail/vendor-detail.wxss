/* ========== 页面容器 ========== */
page {
  background-color: var(--color-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

view, text, image, button {
  box-sizing: border-box;
}

.page-container {
  width: 750rpx;
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ========== 黄色渐变头部 ========== */
.vd-header {
  width: 750rpx;
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-dark) 70%, var(--color-bg-page) 100%);
  padding: 0 30rpx 32rpx;
}

.vd-back-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

/* ========== 摊位信息卡片 ========== */
.vd-shop-card {
  width: 690rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-md);
}

.vd-shop-top {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--space-md);
}

.vd-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xxl);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.vd-shop-info {
  flex: 1;
  min-width: 0;
}

.vd-shop-name {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: var(--space-xs);
}

.vd-shop-meta {
  display: flex;
  align-items: center;
}

.vd-rating-badge {
  display: flex;
  align-items: center;
  background: var(--color-primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-right: 12rpx;
}

.vd-score {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: #FF6633;
  margin-left: 8rpx;
}

.vd-review-link {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.vd-fav-icon {
  padding: var(--space-xs);
  margin-left: auto;
}

/* ========== 信息网格 ========== */
.vd-info-grid {
  display: flex;
  flex-wrap: wrap;
}

.vd-info-cell {
  width: 48%;
  display: flex;
  align-items: center;
  padding: var(--space-sm);
  background: var(--color-divider);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  margin-right: 4%;
  margin-bottom: 12rpx;
}

.vd-info-cell:nth-child(2n) {
  margin-right: 0;
}

.vd-info-cell.full {
  width: 100%;
  margin-right: 0;
}

.vd-info-cell icon {
  margin-right: var(--space-xs);
  flex-shrink: 0;
}

.vd-iv {
  color: var(--color-text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-val {
  color: #FF6633;
}

.vd-tags {
  display: flex;
  flex-wrap: wrap;
}

.vd-tag {
  font-size: var(--font-size-xs);
  color: #FF6633;
  background: #FFF3E0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  margin-right: var(--space-xs);
}

/* ========== 通用 Section ========== */
.vd-section {
  width: 690rpx;
  background: var(--color-bg-card);
  margin: var(--space-sm) 30rpx;
  border-radius: var(--radius-md);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
}

.vd-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.vd-title-text {
  margin-left: var(--space-xs);
}

.vd-badge {
  font-size: var(--font-size-xs);
  background: #FF6633;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  font-weight: 600;
  margin-left: var(--space-xs);
}

.vd-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.vd-section-header .vd-section-title {
  margin-bottom: 0;
}

.vd-more {
  font-size: var(--font-size-sm);
  color: #FF6633;
}

/* ========== 商品列表 ========== */
.vd-product {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.vd-product:last-child { border-bottom: none; }

.vd-product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  background: #eee;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.vd-product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.vd-product-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.vd-product-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.vd-product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vd-product-price {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: #FF6633;
}

.vd-yen {
  font-size: var(--font-size-xs);
}

/* ========== 评价列表 ========== */
.vd-review {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.vd-review:last-child { border-bottom: none; }

.vd-review-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.vd-review-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E0E0E0;
  margin-right: 10rpx;
}

.vd-review-user {
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-text-secondary);
  flex: 1;
  margin-right: 10rpx;
}

.vd-review-top rating-stars {
  margin-right: 10rpx;
}

.vd-review-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.vd-review-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-left: 62rpx;
}

/* ========== 空状态 ========== */
.vd-empty {
  text-align: center;
}

.vd-empty-text {
  font-size: var(--font-size-md);
  color: var(--color-text-tertiary);
  padding: 40rpx 0;
}

/* ========== 底部占位 ========== */
.bottom-spacer {
  height: 130rpx;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  font-size: var(--font-size-md);
  color: var(--color-text-tertiary);
}
