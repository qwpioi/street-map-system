<view class="hot-ranking-container">

  <!-- 加载状态 -->
  <empty-state
    wx:if="{{loading}}"
    icon="🔥"
    text="加载中..."
  />

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!loading && vendors.length === 0}}"
    icon="🔥"
    text="3KM内暂无摊位"
    desc="换个地方试试吧"
  />

  <!-- 排行列表 -->
  <view wx:else class="ranking-list">
    <vendor-card
      wx:for="{{vendors}}"
      wx:key="id"
      vendor="{{item}}"
      showRank="{{true}}"
      showFavorite="{{false}}"
      showDistance="{{true}}"
      bind:tap="onVendorTap"
    />
  </view>

</view>
