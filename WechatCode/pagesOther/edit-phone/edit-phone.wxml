<view class="container">
  <view class="form-group">
    <text class="label">联系电话 <text class="required">*</text></text>
    <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onInputPhone" />
  </view>
  <button class="btn-save" bindtap="onSave" loading="{{saving}}">保存</button>
</view>
