<view class="container">
  <!-- 页面头部：定位 + 搜索 -->
  <page-header
    address="{{address}}"
    show-search="{{true}}"
    bind:locationtap="onLocationTap"
  />

  <!-- 运营 Banner -->
  <view class="banner-card">
    <view class="banner-title">发现身边好摊位</view>
    <view class="banner-sub">3公里内精选美食摊位</view>
    <view class="banner-tag">
      <icon name="fire" size="xs" color="#fff" />
      <text class="banner-tag-text">今日热门</text>
    </view>
  </view>

  <!-- 功能入口网格 4×2 -->
  <view class="category-grid">
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goNearby">
      <view class="cat-icon c1"><icon name="shop" size="md" /></view>
      <text class="cat-text">附近摊位</text>
    </view>
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goMap">
      <view class="cat-icon c2"><icon name="map" size="md" /></view>
      <text class="cat-text">地图找摊</text>
    </view>
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goHotList">
      <view class="cat-icon c3"><icon name="fire" size="md" /></view>
      <text class="cat-text">热门排行</text>
    </view>
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goFavorite">
      <view class="cat-icon c4"><icon name="heart-filled" size="md" /></view>
      <text class="cat-text">我的收藏</text>
    </view>
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goCategories">
      <view class="cat-icon c5"><icon name="food" size="md" /></view>
      <text class="cat-text">美食小吃</text>
    </view>
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goAllServices">
      <view class="cat-icon c6"><icon name="star" size="md" /></view>
      <text class="cat-text">手工文创</text>
    </view>
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goComments">
      <view class="cat-icon c7"><icon name="review" size="md" /></view>
      <text class="cat-text">我的评价</text>
    </view>
    <view class="cat-item" hover-class="cat-item-hover" bindtap="goBecomeVendor">
      <view class="cat-icon c8"><icon name="edit" size="md" /></view>
      <text class="cat-text">成为摊主</text>
    </view>
  </view>

  <!-- 快速状态条 -->
  <view class="quick-strip">
    <view class="quick-chip">
      <text class="qc-dot"></text>
      <text>附近{{vendors.length}}家摊位</text>
    </view>
    <view class="quick-chip">
      <text class="qc-dot hot"></text>
      <text>排行榜更新</text>
    </view>
    <view class="quick-chip" hover-class="quick-chip-hover" bindtap="goBecomeVendor">
      <icon name="edit" size="xs" color="#666" />
      <text>成为摊主</text>
    </view>
  </view>

  <!-- 推荐摊位列表 -->
  <view class="vendor-section">
    <section-header
      title="推荐摊位"
      more-text="智能排序"
      bind:more="onMoreTap"
    />

    <view class="vendor-list">
      <vendor-card
        wx:for="{{vendors}}"
        wx:key="id"
        vendor="{{item}}"
        show-distance="{{true}}"
        show-favorite="{{isLoggedIn}}"
        bind:tap="onVendorCardTap"
        bind:favorite="onToggleFavorite"
        bind:navigate="navigateToVendor"
      />
    </view>

    <!-- 空状态 -->
    <empty-state
      wx:if="{{vendors.length === 0 && location}}"
      icon="😢"
      text="附近暂无摊位"
    />
  </view>

  <!-- 摊位详情弹窗 -->
  <vendor-modal
    visible="{{vendorDetailVisible}}"
    vendor="{{selectedVendor}}"
    products="{{vendorProducts}}"
    reviews="{{recentReviews}}"
    is-logged-in="{{isLoggedIn}}"
    average-rating="{{averageRating}}"
    review-count="{{reviewCount}}"
    bind:close="onCloseVendorDetail"
    bind:navigate="navigateToVendor"
    bind:toggleFavorite="onToggleFavoriteInModal"
    bind:review="onAddReview"
    bind:viewAllReviews="onViewAllReviews"
    bind:viewVendor="goToVendorPage"
  />
</view>
