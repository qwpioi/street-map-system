<view class="container">
  <!-- 搜索框 -->
  <view class="search-box">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索摊位、商品...</text>
  </view>

  <!-- 功能入口 -->
  <view class="function-grid">
    <view class="function-item" bindtap="goNearby">
      <view class="function-icon icon-gradient-gold">
        <text class="icon">🏪</text>
      </view>
      <text class="function-text">附近摊位</text>
    </view>
    
    <view class="function-item" bindtap="goBecomeVendor">
      <view class="function-icon icon-gradient-green">
        <text class="icon">📝</text>
      </view>
      <text class="function-text">成为摊主</text>
    </view>
    
    <view class="function-item" bindtap="goFavorite">
      <view class="function-icon icon-gradient-red">
        <text class="icon">⭐</text>
      </view>
      <text class="function-text">我的收藏</text>
    </view>
    
    <view class="function-item" bindtap="goCategories">
      <view class="function-icon icon-gradient-blue">
        <text class="icon">🍜</text>
      </view>
      <text class="function-text">摊位分类</text>
    </view>
    
    <view class="function-item" bindtap="goHotList">
      <view class="function-icon icon-gradient-hot">
        <text class="icon">🔥</text>
      </view>
      <text class="function-text">热门排行</text>
    </view>
    
    <view class="function-item" bindtap="goMap">
      <view class="function-icon icon-gradient-map">
        <text class="icon">🗺️</text>
      </view>
      <text class="function-text">地图导航</text>
    </view>
    
    <view class="function-item" bindtap="goComments">
      <view class="function-icon icon-gradient-purple">
        <text class="icon">💬</text>
      </view>
      <text class="function-text">我的评价</text>
    </view>
    
    <view class="function-item" bindtap="goAllServices">
      <view class="function-icon icon-gradient-gray">
        <text class="icon">⋯</text>
      </view>
      <text class="function-text">全部服务</text>
    </view>
  </view>

  <!-- 摊位列表 -->
  <view class="vendor-section">
    <view class="section-header">
      <text class="section-title">推荐摊位</text>
      <text class="section-subtitle">按距离排序</text>
    </view>

    <view class="vendor-list">
      <view 
        class="vendor-card" 
        wx:for="{{vendors}}" 
        wx:key="id"
        bindtap="onVendorCardTap"
        data-item="{{item}}"
      >
        <view class="vendor-image">
          <text class="image-placeholder">🍜</text>
          <view 
            class="favorite-icon-overlay"
            wx:if="{{isLoggedIn}}"
            catchtap="onToggleFavorite"
            data-item="{{item}}"
          >
            <text class="favorite-icon" wx:if="{{item.isFavorite}}">❤️</text>
            <text class="favorite-icon" wx:else>🤍</text>
          </view>
        </view>

        <view class="vendor-info">
          <view class="vendor-top">
            <text class="vendor-name">{{item.stallName}}</text>
            <text class="vendor-distance">{{item.distanceText}}</text>
          </view>
          
          <!-- 地址和导航按钮在同一行 -->
          <view class="vendor-address-row" wx:if="{{item.address}}">
            <text class="vendor-address-text">📍 {{item.address}}</text>
            <view class="mini-nav-btn" catchtap="navigateToVendor" data-item="{{item}}">
              🧭 导航
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{vendors.length === 0 && location}}">
      <text class="empty-icon">😢</text>
      <text class="empty-text">附近暂无摊位</text>
    </view>
  </view>

  <!-- 摊位详情弹窗 -->
  <view class="vendor-detail-modal" wx:if="{{vendorDetailVisible && selectedVendor}}">
    <view class="modal-mask" bindtap="onCloseVendorDetail"></view>
    <view class="modal-content">
      <view class="close-btn" bindtap="onCloseVendorDetail">✕</view>
      
      <view class="detail-header" bindtap="goToVendorPage" data-vendor-id="{{selectedVendor.id}}">
        <view class="detail-icon">🍜</view>
        <view class="detail-info">
          <view class="detail-name">{{selectedVendor.stallName}}</view>
          <view class="detail-rating" wx:if="{{averageRating > 0}}">
            <text class="stars">
              <text wx:for="{{stars}}" wx:for-item="star" wx:key="*this" wx:if="{{star <= averageRating}}">⭐</text>
              <text wx:for="{{stars}}" wx:for-item="star" wx:key="*this" wx:if="{{star > averageRating}}">☆</text>
            </text>
            <text class="rating-score">{{averageRating.toFixed(1)}}分</text>
            <text class="review-count">({{reviewCount}}条评价)</text>
          </view>
          <view class="detail-rating" wx:else>
            <text class="no-rating">暂无评分</text>
          </view>
          <view class="modal-favorite-wrapper" catchtap="onToggleFavoriteInModal" data-item="{{selectedVendor}}">
            <text class="modal-heart-icon">{{selectedVendor.isFavorite ? '❤️' : '🤍'}}</text>
            <text class="modal-favorite-text">{{selectedVendor.isFavorite ? '已收藏' : '点击收藏'}}</text>
          </view>
        </view>
      </view>
      
      <view class="detail-body">
        <view class="detail-item" wx:if="{{selectedVendor.address}}">
          <view class="address-row">
            <view class="address-col">
              <text class="item-label">📍 地址</text>
              <text class="item-value">{{selectedVendor.address}}</text>
            </view>
            <view class="nav-btn-small" catchtap="navigateToVendor" data-item="{{selectedVendor}}">
              🧭 导航
            </view>
          </view>
        </view>

        <view class="detail-item" wx:if="{{selectedVendor.phone}}" bindtap="callPhone">
          <text class="item-label">📞 联系电话</text>
          <text class="item-value phone-value">{{selectedVendor.phone}}</text>
        </view>

        <view class="detail-item">
          <text class="item-label">📏 距离</text>
          <text class="item-value distance">{{selectedVendor.distance}}</text>
        </view>
      </view>
      
      <!-- 商品列表 -->
      <view class="products-section" wx:if="{{vendorProducts.length > 0 || selectedVendor.products.length > 0}}">
        <view class="section-title">🔥 热销产品</view>

        <view class="product-list">
          <block wx:for="{{vendorProducts}}" wx:key="id" wx:if="{{index < 5}}">
            <view class="product-card">
              <image class="product-image" src="{{item.imageUrl || 'https://via.placeholder.com/150x150?text=Product'}}" mode="aspectFill" />
              <view class="product-info">
                <view class="product-name">{{item.name}}</view>
                <view class="product-desc" wx:if="{{item.description}}">{{item.description}}</view>
                <view class="product-price">
                  <text class="price-symbol">¥</text>
                  <text class="price-value">{{item.price}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
      
      <view class="reviews-section" wx:if="{{recentReviews.length > 0}}">
        <view class="section-title-with-action">
          <text class="section-title">💬 最新评价</text>
          <text class="view-all" bindtap="onViewAllReviews">查看全部 ></text>
        </view>
        
        <view class="review-list">
          <view class="review-item" wx:for="{{recentReviews}}" wx:key="id">
            <view class="review-header">
              <image class="review-avatar" src="{{item.userAvatar || 'https://via.placeholder.com/100x100?text=Avatar'}}" mode="aspectFill" />
              <view class="review-info">
                <view class="review-user">{{item.userName || '匿名用户'}}</view>
                <view class="review-rating">
                  <text wx:for="{{stars}}" wx:for-item="star" wx:key="*this" wx:if="{{star <= item.rating}}">⭐</text>
                  <text wx:for="{{stars}}" wx:for-item="star" wx:key="*this" wx:if="{{star > item.rating}}">☆</text>
                </view>
              </view>
              <view class="review-time">{{item.createTime}}</view>
            </view>
            <view class="review-content" wx:if="{{item.content}}">{{item.content}}</view>
          </view>
        </view>
      </view>
      
      <view class="empty-reviews" wx:else>
        <text class="empty-icon">😢</text>
        <text class="empty-text">暂无评价，快来成为第一个评价的人吧！</text>
      </view>
      
      <view class="detail-actions">
        <button class="action-btn secondary" bindtap="onAddReview">
          <text>📝 发表评价</text>
        </button>
      </view>
    </view>
  </view>
</view>
