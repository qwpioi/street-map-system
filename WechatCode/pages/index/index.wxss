}

.modal-favorite-text {
  font-size: 22rpx;
  color: #666;
}

/* 弹窗信息网格 */
.detail-body {
  padding: 0 24rpx 16rpx;
  background: #fff;
}

.detail-info-grid {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
  flex-wrap: wrap;
}

.detail-info-cell {
  width: 48%;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-right: 4%;
  margin-bottom: 12rpx;
}

.detail-info-cell:nth-child(2n) {
  margin-right: 0;
}

.dic-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
}

.dic-val {
  color: #1A1A1A;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.distance-val { color: #00C853; font-weight: 600; }
.phone-val { color: #FF6633; }

/* 弹窗内 section */
.modal-section {
  background: #fff;
  margin-top: 12rpx;
  padding: 24rpx;
}

.modal-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.modal-section-header {
  display: -webkit-flex;
  display: flex;
  -webkit-justify-content: space-between;
  justify-content: space-between;
  -webkit-align-items: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.view-all {
  font-size: 24rpx;
  color: #FF6633;
}

/* 弹窗商品列表 */
.modal-product-list {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
}

.modal-product-card {
  display: -webkit-flex;
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-product-card:last-child {
  border-bottom: none;
}

.modal-product-img {
