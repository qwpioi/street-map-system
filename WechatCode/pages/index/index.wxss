/* ========== 全局基础 ========== */
page {
  width: 100%;
  margin: 0;
  padding: 0;
  background-color: var(--color-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  width: 750rpx;
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: var(--space-lg);
  display: block;
  height: auto;
  padding-top: 0;
}

/* ========== 运营 Banner ========== */
.banner-card {
  width: 690rpx;
  background: linear-gradient(135deg, #FF6633 0%, #FF3366 100%);
  border-radius: var(--radius-lg);
  padding: var(--space-md) var(--space-lg);
  color: #fff;
  margin: var(--space-md) var(--space-lg);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.banner-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  margin-bottom: var(--space-xs);
}

.banner-sub {
  font-size: var(--font-size-sm);
  opacity: 0.9;
}

.banner-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  margin-top: var(--space-sm);
}

.banner-tag-text {
  margin-left: 4rpx;
}

/* ========== 功能入口网格 ========== */
.category-grid {
  width: 690rpx;
  display: flex;
  flex-wrap: wrap;
  padding: var(--space-sm) 0;
  margin: 0 var(--space-lg);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.cat-item {
  width: 172rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-sm) 0;
  transition: transform var(--transition-fast);
}

.cat-item-hover {
  transform: scale(0.95);
  opacity: 0.8;
}

.cat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xl);
  margin-bottom: var(--space-sm);
}

.cat-icon.c1 { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); }
.cat-icon.c2 { background: linear-gradient(135deg, #E8F5E9, #C8E6C9); }
.cat-icon.c3 { background: linear-gradient(135deg, #FFF8E1, #FFECB3); }
.cat-icon.c4 { background: linear-gradient(135deg, #FCE4EC, #F8BBD0); }
.cat-icon.c5 { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); }
.cat-icon.c6 { background: linear-gradient(135deg, #E0F7FA, #B2EBF2); }
.cat-icon.c7 { background: linear-gradient(135deg, #F3E5F5, #E1BEE7); }
.cat-icon.c8 { background: linear-gradient(135deg, #ECEFF1, #CFD8DC); }

.cat-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

/* ========== 快速状态条 ========== */
.quick-strip {
  display: flex;
  flex-wrap: wrap;
  padding: var(--space-sm) var(--space-lg);
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  padding: var(--space-sm) var(--space-md);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  box-shadow: var(--shadow-sm);
  margin-right: var(--space-sm);
  margin-bottom: var(--space-xs);
  transition: all var(--transition-fast);
}

.quick-chip-hover {
  background: var(--color-primary-light);
  transform: scale(0.95);
}

.qc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-success);
  margin-right: var(--space-xs);
}

.qc-dot.hot {
  background: var(--color-danger);
}

/* ========== 推荐摊位 Section ========== */
.vendor-section {
  padding: 0 var(--space-lg);
}

.vendor-list {
  display: flex;
  flex-direction: column;
}
