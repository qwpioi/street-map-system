.modal-favorite-wrapper {
  display: -webkit-inline-flex;
  display: inline-flex;
  -webkit-align-items: center;
  align-items: center;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  background: #F9F9F9;
