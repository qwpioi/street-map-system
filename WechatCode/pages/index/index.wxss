/* ========== 全局 ========== */
page {
  width: 100%;
  margin: 0;
  padding: 0;
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 20rpx;
}

/* ========== 黄色头部 ========== */
.home-header {
  background: #FFD100;
  padding: 16rpx 24rpx 24rpx;
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.location-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.location-pin { font-size: 28rpx; }
.location-text { font-size: 28rpx; font-weight: 600; color: #1A1A1A; }
.location-arrow { font-size: 20rpx; color: #666; }

.weather-badge {
  font-size: 22rpx;
  color: #666;
  background: rgba(255,255,255,0.5);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
  gap: 12rpx;
}

.s-icon { font-size: 26rpx; color: #999; }
.s-text { font-size: 26rpx; color: #BBB; }

/* ========== 运营 Banner ========== */
.banner-card {
  margin: 20rpx 24rpx;
  background: linear-gradient(135deg, #FF6633 0%, #FF3366 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.banner-title { font-size: 34rpx; font-weight: 700; margin-bottom: 6rpx; }
.banner-sub { font-size: 24rpx; opacity: 0.9; }

.banner-tag {
  display: inline-block;
  background: rgba(255,255,255,0.25);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  margin-top: 12rpx;
}

/* ========== 功能入口网格 ========== */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 24rpx 16rpx;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0;
}

.cat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.cat-icon.c1 { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); }
.cat-icon.c2 { background: linear-gradient(135deg, #E8F5E9, #C8E6C9); }
.cat-icon.c3 { background: linear-gradient(135deg, #FFF8E1, #FFECB3); }
.cat-icon.c4 { background: linear-gradient(135deg, #FCE4EC, #F8BBD0); }
.cat-icon.c5 { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); }
.cat-icon.c6 { background: linear-gradient(135deg, #E0F7FA, #B2EBF2); }
.cat-icon.c7 { background: linear-gradient(135deg, #F3E5F5, #E1BEE7); }
.cat-icon.c8 { background: linear-gradient(135deg, #ECEFF1, #CFD8DC); }

.cat-text { font-size: 22rpx; color: #333; }

/* ========== 快速状态条 ========== */
.quick-strip {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  flex-shrink: 0;
}

.qc-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #00C853;
}

.qc-dot.hot { background: #FF3366; }

/* ========== 推荐摊位 Section ========== */
.vendor-section {
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* ========== 摊位卡片（美团风格）========== */
.vendor-list {
  display: flex;
  flex-direction: column;
}

.vendor-card-mt {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.vcm-top {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}

.vcm-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.vcm-emoji { font-size: 56rpx; }

.vcm-open-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,200,83,0.9);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  padding: 2rpx 0;
}

.vcm-open-badge.closed {
  background: rgba(153,153,153,0.9);
}

.vcm-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.vcm-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vcm-rating-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.vcm-stars {
  display: flex;
  gap: 2rpx;
}

.vcm-star { font-size: 22rpx; color: #FFD100; }

.vcm-distance {
  font-size: 24rpx;
  color: #00C853;
  font-weight: 600;
}

.vcm-tags-row {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.vcm-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #FFF3E0;
  color: #FF6633;
  white-space: nowrap;
}

.vcm-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.vcm-address {
  font-size: 22rpx;
  color: #999;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vcm-actions {
  display: flex;
  gap: 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.vcm-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.vcm-btn.nav-btn { background: #E8F5E9; }
.vcm-btn.fav-btn { background: #FFF3E0; }

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }

/* ========== 弹窗 ========== */
.vendor-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F5F5F5;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(0,0,0,0.06);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  z-index: 10;
}

/* 弹窗头部 */
.detail-header {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx 24rpx;
  background: #fff;
}

.detail-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.detail-info { flex: 1; }

.detail-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.detail-rating {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.detail-rating-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.detail-star { font-size: 22rpx; color: #FFD100; }
.detail-score { font-size: 26rpx; font-weight: 700; color: #FF6633; }
.review-count { font-size: 22rpx; color: #999; }
.no-rating { font-size: 24rpx; color: #999; }

.modal-favorite-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  width: fit-content;
}

.modal-heart-icon { font-size: 26rpx; }
.modal-favorite-text { font-size: 22rpx; color: #666; }

/* 弹窗信息网格 */
.detail-body {
  padding: 0 24rpx 16rpx;
  background: #fff;
}

.detail-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.detail-info-cell {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.dic-icon { font-size: 24rpx; }
.dic-val { color: #1A1A1A; font-weight: 500; }
.distance-val { color: #00C853; font-weight: 600; }
.phone-val { color: #FF6633; }

/* 弹窗内 section */
.modal-section {
  background: #fff;
  margin-top: 12rpx;
  padding: 24rpx;
}

.modal-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.modal-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.view-all { font-size: 24rpx; color: #FF6633; }

/* 弹窗商品列表 */
.modal-product-list {
  display: flex;
  flex-direction: column;
}

.modal-product-card {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-product-card:last-child { border-bottom: none; }

.modal-product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eee;
}

.modal-product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.modal-product-name { font-size: 28rpx; font-weight: 600; color: #1A1A1A; }
.modal-product-desc { font-size: 22rpx; color: #999; line-height: 1.4; }

.modal-product-price { display: flex; align-items: baseline; gap: 4rpx; }
.price-symbol { font-size: 22rpx; color: #FF6633; }
.price-value { font-size: 32rpx; color: #FF6633; font-weight: 700; }

/* 弹窗评价列表 */
.modal-review-list {
  display: flex;
  flex-direction: column;
}

.modal-review-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-review-item:last-child { border-bottom: none; }

.modal-review-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.modal-review-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.modal-review-user { font-size: 24rpx; font-weight: 500; color: #333; flex: 1; }

.modal-review-stars {
  display: flex;
  gap: 2rpx;
  font-size: 20rpx;
  color: #FFD100;
}

.modal-review-time { font-size: 20rpx; color: #CCC; }
.modal-review-content { font-size: 26rpx; color: #666; line-height: 1.5; margin-left: 58rpx; }

/* 空评价 */
.empty-reviews {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background: #fff;
  margin-top: 12rpx;
}

/* 弹窗底部操作 */
.modal-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  margin-top: 12rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-action-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.modal-action-btn.secondary {
  background: #FFFDE7;
  color: #FF6633;
  border: 1rpx solid #FFD100;
}

.modal-action-btn.primary {
  background: linear-gradient(135deg, #FFD100, #FFC107);
  color: #1A1A1A;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255,209,0,0.3);
}

.modal-action-btn::after { border: none; }
