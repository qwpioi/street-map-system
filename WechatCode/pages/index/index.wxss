/* ========== 全局基础 ========== */
page {
  width: 100%;
  margin: 0;
  padding: 0;
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* 全局 box-sizing */
view, text, image, button, scroll-view {
  box-sizing: border-box;
}

.container {
  width: 750rpx;
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 20rpx;
  /* 兜底：显式重置全局 .container 模板样式的侵入 */
  display: block;
  height: auto;
  padding-top: 0;
}

/* ========== 黄色头部 ========== */
.home-header {
  width: 750rpx;
  background: #FFD100;
  padding: 20rpx 30rpx 28rpx;
}

.location-row {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: space-between;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.location-left {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
}

.location-pin {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.location-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.location-arrow {
  font-size: 20rpx;
  color: #666;
  margin-left: 4rpx;
}

.weather-badge {
  font-size: 22rpx;
  color: #666;
  background: rgba(255,255,255,0.5);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.search-bar {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  background: #fff;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
}

.s-icon {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.s-text {
  font-size: 26rpx;
  color: #BBB;
}

/* ========== 运营 Banner ========== */
.banner-card {
  width: 690rpx;
  background: linear-gradient(135deg, #FF6633 0%, #FF3366 100%);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  color: #fff;
  margin: 20rpx 30rpx;
  position: relative;
  overflow: hidden;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.banner-tag {
  display: inline-block;
  background: rgba(255,255,255,0.25);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  margin-top: 12rpx;
}

/* ========== 功能入口网格 ========== */
.category-grid {
  width: 690rpx;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
  flex-wrap: wrap;
  padding: 10rpx 0;
  margin: 0 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.cat-item {
  width: 172rpx;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: center;
  align-items: center;
  padding: 14rpx 0;
}

.cat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.cat-icon.c1 { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); }
.cat-icon.c2 { background: linear-gradient(135deg, #E8F5E9, #C8E6C9); }
.cat-icon.c3 { background: linear-gradient(135deg, #FFF8E1, #FFECB3); }
.cat-icon.c4 { background: linear-gradient(135deg, #FCE4EC, #F8BBD0); }
.cat-icon.c5 { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); }
.cat-icon.c6 { background: linear-gradient(135deg, #E0F7FA, #B2EBF2); }
.cat-icon.c7 { background: linear-gradient(135deg, #F3E5F5, #E1BEE7); }
.cat-icon.c8 { background: linear-gradient(135deg, #ECEFF1, #CFD8DC); }

.cat-text {
  font-size: 22rpx;
  color: #333;
}

/* ========== 快速状态条 ========== */
.quick-strip {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
  flex-wrap: wrap;
  padding: 16rpx 30rpx;
}

.quick-chip {
  display: -webkit-inline-flex;
  display: inline-flex;
  -webkit-align-items: center;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.qc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00C853;
  margin-right: 8rpx;
}

.qc-dot.hot {
  background: #FF3366;
}

/* ========== 推荐摊位 Section ========== */
.vendor-section {
  padding: 0 30rpx;
}

.section-header {
  display: -webkit-flex;
  display: flex;
  -webkit-justify-content: space-between;
  justify-content: space-between;
  -webkit-align-items: center;
  align-items: center;
  padding: 20rpx 0 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* ========== 摊位卡片 ========== */
.vendor-list {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
}

.vendor-card-mt {
  width: 690rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.vcm-top {
  display: -webkit-flex;
  display: flex;
  padding: 20rpx;
}

.vcm-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  margin-right: 16rpx;
}

.vcm-emoji {
  font-size: 48rpx;
}

.vcm-open-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,200,83,0.9);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  padding: 2rpx 0;
}

.vcm-open-badge.closed {
  background: rgba(153,153,153,0.9);
}

.vcm-info {
  -webkit-flex: 1;
  flex: 1;
  min-width: 0;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-justify-content: center;
  justify-content: center;
}

.vcm-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vcm-rating-row {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  margin-top: 8rpx;
}

.vcm-stars {
  display: -webkit-flex;
  display: flex;
  margin-right: 10rpx;
}

.vcm-star {
  font-size: 20rpx;
  color: #FFD100;
  margin-right: 2rpx;
}

.vcm-distance {
  font-size: 22rpx;
  color: #00C853;
  font-weight: 600;
}

.vcm-tags-row {
  display: -webkit-flex;
  display: flex;
  margin-top: 8rpx;
  overflow: hidden;
}

.vcm-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #FFF3E0;
  color: #FF6633;
  white-space: nowrap;
  margin-right: 8rpx;
}

.vcm-bottom {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: space-between;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.vcm-address {
  font-size: 22rpx;
  color: #999;
  -webkit-flex: 1;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vcm-actions {
  display: -webkit-flex;
  display: flex;
  margin-left: 12rpx;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
}

.vcm-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 22rpx;
  margin-left: 10rpx;
}

.vcm-btn.nav-btn { background: #E8F5E9; }
.vcm-btn.fav-btn { background: #FFF3E0; }

/* ========== 空状态 ========== */
.empty-state {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* ========== 弹窗 ========== */
.vendor-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F5F5F5;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(0,0,0,0.06);
  border-radius: 50%;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  z-index: 10;
}

/* 弹窗头部 */
.detail-header {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  padding: 32rpx 24rpx 24rpx;
  background: #fff;
}

.detail-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
}

.detail-info {
  -webkit-flex: 1;
  flex: 1;
  min-width: 0;
}

.detail-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.detail-rating {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
}

.detail-rating-badge {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  background: #FFF8E1;
