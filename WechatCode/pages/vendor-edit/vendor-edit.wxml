<view class="container">
  <!-- 头像区域 -->
  <view class="form-group" bindtap="onChooseAvatar">
    <text class="label">摊位头像</text>
    <view wx:if="{{!avatar}}" class="image-picker">
      <text class="picker-icon">📷</text>
      <text class="picker-text">点击上传头像</text>
    </view>
    <view wx:else class="image-preview">
      <image class="preview-img" src="{{avatar}}" mode="aspectFill" />
      <view class="remove-btn" catchtap="onRemoveAvatar">✕</view>
    </view>
  </view>

  <!-- 摊位名称 -->
  <view class="form-group">
    <text class="label">摊位名称 *</text>
    <input
      class="input"
      value="{{stallName}}"
      placeholder="请输入摊位名称"
      maxlength="20"
      bindinput="onInputName"
    />
  </view>

  <!-- 联系电话 -->
  <view class="form-group">
    <text class="label">联系电话</text>
    <input
      class="input"
      value="{{phone}}"
      type="number"
      placeholder="请输入手机号"
      maxlength="11"
      bindinput="onInputPhone"
    />
  </view>

  <!-- 保存按钮 -->
  <view class="actions">
    <button class="btn-submit" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
    <button class="btn-cancel" bindtap="onCancel">取消</button>
  </view>
</view>
