<view class="favorite-container">
  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-icon">⏳</text>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && favorites.length === 0}}">
    <text class="empty-icon">⭐</text>
    <text class="empty-text">暂无收藏摊位</text>
    <text class="empty-desc">去首页发现更多美食吧~</text>
    <button class="go-home-btn" bindtap="goHome">去首页逛逛</button>
  </view>

  <!-- 收藏列表 -->
  <view class="favorite-list" wx:else>
    <view class="list-header">
      <text class="header-title">已收藏 {{favorites.length}} 个摊位</text>
    </view>

    <view 
      class="favorite-item" 
      wx:for="{{favorites}}" 
      wx:key="id"
      data-item="{{item}}"
      bindtap="onFavoriteItemTap"
    >
      <view class="item-content">
        <view class="item-header">
          <text class="item-name">{{item.stallName}}</text>
          <view 
            class="favorite-btn active"
            catchtap="onCancelFavorite"
            data-item="{{item}}"
          >
            <text class="heart-icon">❤️</text>
            <text class="btn-text">取消</text>
          </view>
        </view>

        <view class="item-info">
          <text class="item-address">📍 {{item.address}}</text>
          <text class="item-products" wx:if="{{item.hotProducts}}">🍜 {{item.hotProducts}}</text>
        </view>
      </view>

      <view class="item-footer">
        <text class="item-time">收藏时间：{{item.createTime}}</text>
      </view>
    </view>
  </view>
</view>
