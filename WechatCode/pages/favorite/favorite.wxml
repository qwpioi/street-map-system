<view class="favorite-container">
  <!-- 加载状态 -->
  <empty-state wx:if="{{loading}}" icon="⏳" text="加载中..." />

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!loading && favorites.length === 0}}"
    icon="⭐"
    text="暂无收藏摊位"
    desc="去首页发现更多美食吧~"
    buttonText="去首页逛逛"
    bind:action="goHome"
  />

  <!-- 收藏列表 -->
  <view wx:else>
    <!-- 黄色头部 -->
    <view class="fav-header">
      <text class="fav-title">我的收藏</text>
      <text class="fav-count">共{{favorites.length}}个摊位</text>
    </view>

    <!-- 收藏卡片列表 -->
    <view class="fav-list">
      <vendor-card
        wx:for="{{favorites}}"
        wx:key="id"
        vendor="{{item}}"
        show-distance="{{true}}"
        show-favorite="{{true}}"
        bind:tap="onFavoriteItemTap"
        bind:favorite="onCancelFavorite"
      />
    </view>
  </view>

  <!-- 摊位详情弹窗 -->
  <vendor-modal
    visible="{{vendorDetailVisible}}"
    vendor="{{selectedVendor}}"
    products="{{vendorProducts}}"
    reviews="{{recentReviews}}"
    is-logged-in="{{isLoggedIn}}"
    average-rating="{{averageRating}}"
    review-count="{{reviewCount}}"
    bind:close="onCloseVendorDetail"
    bind:navigate="navigateToVendor"
    bind:toggle-favorite="onToggleFavoriteInModal"
    bind:review="onAddReview"
    bind:view-all-reviews="onViewAllReviews"
    bind:view-vendor="goToVendorPage"
  />
</view>
