page {
  background: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

view, text, image, button {
  box-sizing: border-box;
}

.favorite-container {
  width: 750rpx;
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* ========== 加载状态 ========== */
.loading-state {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 空状态 ========== */
.empty-state {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon { font-size: 120rpx; margin-bottom: 30rpx; }

.empty-text {
  font-size: 32rpx;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-home-btn {
  background: linear-gradient(135deg, #FFD100, #FFC107) !important;
  color: #1A1A1A !important;
  border-radius: 36rpx;
  width: 300rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none !important;
  box-shadow: 0 4rpx 16rpx rgba(255,209,0,0.3);
}

.go-home-btn::after { border: none; }

/* ========== 黄色头部 ========== */
.fav-header {
  width: 750rpx;
  background: #FFD100;
  padding: 24rpx 30rpx;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: space-between;
  justify-content: space-between;
}

.fav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.fav-count {
  font-size: 24rpx;
  color: #666;
}

/* ========== 收藏卡片列表 ========== */
.fav-list {
  padding: 16rpx 30rpx;
}

.fav-card {
  display: -webkit-flex;
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.fav-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 48rpx;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.fav-info {
  -webkit-flex: 1;
  flex: 1;
  min-width: 0;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-justify-content: space-between;
  justify-content: space-between;
}

.fav-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-meta {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  margin-top: 8rpx;
}

.fav-address {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.fav-products {
  font-size: 24rpx;
  color: #FF6633;
}

.fav-bottom-row {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: space-between;
  justify-content: space-between;
  margin-top: 12rpx;
}

.fav-time {
  font-size: 20rpx;
  color: #CCC;
}

.fav-unfav-btn {
  font-size: 22rpx;
  color: #FF6633;
  background: #FFF3E0;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

/* ========== 摊位详情弹窗 ========== */

.vendor-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F5F5F5;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(0,0,0,0.06);
  border-radius: 50%;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  z-index: 10;
}

.detail-header {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  padding: 32rpx 24rpx 24rpx;
  background: #fff;
}

.detail-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
}

.detail-info {
  -webkit-flex: 1;
  flex: 1;
  min-width: 0;
}

.detail-name {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.name-text {
  -webkit-flex: 1;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-arrow {
  font-size: 32rpx;
  color: #999;
  margin-left: 8rpx;
  font-weight: 400;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
}

.detail-rating {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
}

.detail-rating-badge {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 10rpx;
}

.detail-star {
  font-size: 22rpx;
  color: #FFD100;
  margin-right: 4rpx;
}

.detail-score {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF6633;
}

.review-count {
  font-size: 22rpx;
  color: #999;
}

.no-rating {
  font-size: 24rpx;
  color: #999;
}

.modal-favorite-wrapper {
  display: -webkit-inline-flex;
  display: inline-flex;
  -webkit-align-items: center;
  align-items: center;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
}

.modal-heart-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.modal-favorite-text {
  font-size: 22rpx;
  color: #666;
}

.detail-body {
  padding: 0 24rpx 16rpx;
  background: #fff;
}

.detail-info-grid {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-wrap: wrap;
  flex-wrap: wrap;
}

.detail-info-cell {
  width: 48%;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-right: 4%;
  margin-bottom: 12rpx;
}

.detail-info-cell:nth-child(2n) {
  margin-right: 0;
}

.dic-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
}

.dic-val {
  color: #1A1A1A;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.distance-val { color: #00C853; font-weight: 600; }
.phone-val { color: #FF6633; }

.modal-section {
  background: #fff;
  margin-top: 12rpx;
  padding: 24rpx;
}

.modal-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.modal-badge {
  font-size: 20rpx;
  background: #FF6633;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.modal-section-header {
  display: -webkit-flex;
  display: flex;
  -webkit-justify-content: space-between;
  justify-content: space-between;
  -webkit-align-items: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.view-all {
  font-size: 24rpx;
  color: #FF6633;
}

.modal-product-list {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
}

.modal-product-card {
  display: -webkit-flex;
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-product-card:last-child {
  border-bottom: none;
}

.modal-product-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  background: #eee;
  margin-right: 16rpx;
}

.modal-product-info {
  -webkit-flex: 1;
  flex: 1;
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-justify-content: space-between;
  justify-content: space-between;
  min-width: 0;
}

.modal-product-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-product-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.modal-product-price {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: baseline;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #FF6633;
  margin-right: 4rpx;
}

.price-value {
  font-size: 30rpx;
  color: #FF6633;
  font-weight: 700;
}

.modal-review-list {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
}

.modal-review-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-review-item:last-child {
  border-bottom: none;
}

.modal-review-top {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  margin-bottom: 10rpx;
}

.modal-review-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E0E0E0;
  margin-right: 10rpx;
}

.modal-review-user {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  -webkit-flex: 1;
  flex: 1;
  margin-right: 10rpx;
}

.modal-review-stars {
  display: -webkit-flex;
  display: flex;
  font-size: 20rpx;
  color: #FFD100;
  margin-right: 10rpx;
}

.modal-review-time {
  font-size: 20rpx;
  color: #CCC;
}

.modal-review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-left: 54rpx;
}

.empty-reviews {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: center;
  align-items: center;
  padding: 60rpx 0;
  background: #fff;
  margin-top: 12rpx;
}

.modal-actions {
  display: -webkit-flex;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: 40rpx;
  background: #fff;
  margin-top: 12rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-action-btn {
  -webkit-flex: 1;
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  font-size: 26rpx;
  border: none;
  padding: 0;
  margin: 0;
  margin-right: 16rpx;
}

.modal-action-btn:last-child {
  margin-right: 0;
}

.modal-action-btn.secondary {
  background: #FFFDE7;
  color: #FF6633;
  border: 1rpx solid #FFD100;
}

.modal-action-btn.primary {
  background: linear-gradient(135deg, #FFD100, #FFC107);
  color: #1A1A1A;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255,209,0,0.3);
}

.modal-action-btn::after {
  border: none;
}
