page {
  background: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.favorite-container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* ========== 加载状态 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon { font-size: 120rpx; margin-bottom: 30rpx; }

.empty-text {
  font-size: 32rpx;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-home-btn {
  background: linear-gradient(135deg, #FFD100, #FFC107) !important;
  color: #1A1A1A !important;
  border-radius: 36rpx;
  width: 300rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none !important;
  box-shadow: 0 4rpx 16rpx rgba(255,209,0,0.3);
}

.go-home-btn::after { border: none; }

/* ========== 黄色头部 ========== */
.fav-header {
  background: #FFD100;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.fav-count {
  font-size: 24rpx;
  color: #666;
}

/* ========== 收藏卡片列表 ========== */
.fav-list {
  padding: 16rpx 24rpx;
}

.fav-card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.fav-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.fav-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.fav-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fav-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 8rpx;
}

.fav-address {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fav-products {
  font-size: 24rpx;
  color: #FF6633;
}

.fav-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.fav-time {
  font-size: 20rpx;
  color: #CCC;
}

.fav-unfav-btn {
  font-size: 22rpx;
  color: #FF6633;
  background: #FFF3E0;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}
