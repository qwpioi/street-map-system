.favorite-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-home-btn {
  background-color: #4CAF50;
  color: #fff;
  border-radius: 40rpx;
  width: 300rpx;
  font-size: 28rpx;
}

/* 列表头部 */
.list-header {
  padding: 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 28rpx;
  color: #666;
}

/* 收藏列表 */
.favorite-list {
  padding: 0 30rpx;
}

.favorite-item {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-content {
  padding: 30rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.favorite-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background-color: #f5f5f5;
}

.favorite-btn.active {
  background-color: #fff0f0;
}

.heart-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.btn-text {
  font-size: 24rpx;
  color: #ff4444;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-address {
  font-size: 26rpx;
  color: #666;
}

.item-products {
  font-size: 26rpx;
  color: #4CAF50;
}

.item-footer {
  padding: 20rpx 30rpx;
  background-color: #fafafa;
  border-top: 1rpx solid #f0f0f0;
}

.item-time {
  font-size: 22rpx;
  color: #999;
}
