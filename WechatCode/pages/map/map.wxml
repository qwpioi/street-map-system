<view class="map-container">
  <!-- 全屏地图 -->
  <map
    id="fullMap"
    class="full-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="16"
    markers="{{markers}}"
    show-location="true"
    bindmarkertap="onMarkerTap"
  >
  </map>

  <!-- 定位按钮 -->
  <view class="locate-btn" hover-class="locate-btn-hover" bindtap="relocate">
    <icon name="location" size="sm" color="var(--color-primary-dark)" />
    <text class="locate-text">定位</text>
  </view>

  <!-- 摊位统计 -->
  <view class="map-stats" wx:if="{{vendors.length > 0}}">
    <icon name="shop" size="xs" color="#fff" />
    <text class="stats-text">附近 {{vendors.length}} 个摊位</text>
  </view>

  <!-- 摊位详情弹窗（使用组件替代重复代码） -->
  <vendor-modal
    visible="{{vendorDetailVisible}}"
    vendor="{{selectedVendor}}"
    products="{{vendorProducts}}"
    reviews="{{recentReviews}}"
    is-logged-in="{{isLoggedIn}}"
    average-rating="{{averageRating}}"
    review-count="{{reviewCount}}"
    bind:close="onCloseVendorDetail"
    bind:navigate="navigateToVendor"
    bind:toggleFavorite="onToggleFavoriteInModal"
    bind:review="onAddReview"
    bind:viewAllReviews="onViewAllReviews"
    bind:viewVendor="goToVendorPage"
  />
</view>
