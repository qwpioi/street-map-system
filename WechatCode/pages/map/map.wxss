.map-container {
  height: 100vh;
  position: relative;
  background-color: #f0f0f0;
}

.full-map {
  width: 100%;
  height: 100%;
}

.locate-btn {
  position: absolute;
  bottom: 200rpx;
  right: 30rpx;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  z-index: 10;
}

.locate-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.map-stats {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  background-color: rgba(0,0,0,0.7);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  z-index: 10;
}

.stats-text {
  color: #fff;
  font-size: 24rpx;
}

/* ========== 摊位详情弹窗 ========== */

.vendor-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.close-btn {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 28px;
  height: 28px;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #666;
  z-index: 10;
}

.detail-header {
  display: flex;
  align-items: center;
  padding: 20px 16px 16px;
  border-bottom: 1px solid #f0f0f0;
}

.detail-icon {
  font-size: 48px;
  margin-right: 16px;
}

.detail-info {
  flex: 1;
}

.detail-name {
  font-size: 20px;
  font-weight: bold;
  color: #333;
  margin-bottom: 8px;
}

.detail-rating {
  display: flex;
  align-items: center;
  gap: 8px;
}

.stars {
  font-size: 16px;
}

.rating-score {
  font-size: 14px;
  color: #ff9800;
  font-weight: bold;
}

.review-count {
  font-size: 12px;
  color: #999;
}

.no-rating {
  font-size: 14px;
  color: #999;
}

.detail-body {
  padding: 16px;
}

.detail-item {
  margin-bottom: 16px;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.item-label {
  display: block;
  font-size: 13px;
  color: #999;
  margin-bottom: 6px;
}

.item-value {
  font-size: 15px;
  color: #333;
}

.item-value.distance {
  color: #4caf50;
  font-weight: bold;
}

.item-value.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  background: #f5f5f5;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 13px;
  color: #666;
}

/* 商品列表 */
.products-section {
  padding: 16px;
  border-top: 8px solid #f5f5f5;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12px;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.product-card {
  display: flex;
  gap: 12px;
  background: #f9f9f9;
  padding: 12px;
  border-radius: 8px;
}

.product-image {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #e0e0e0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 15px;
  font-weight: bold;
  color: #333;
}

.product-desc {
  font-size: 13px;
  color: #999;
  line-height: 1.4;
}

.product-price {
  display: flex;
  align-items: baseline;
  gap: 2px;
}

.price-symbol {
  font-size: 14px;
  color: #ff6b00;
}

.price-value {
  font-size: 18px;
  color: #ff6b00;
  font-weight: bold;
}

/* 评价列表 */
.reviews-section {
  padding: 16px;
  border-top: 8px solid #f5f5f5;
}

.section-title-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.view-all {
  font-size: 13px;
  color: #409eff;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.review-item {
  background: #f9f9f9;
  padding: 12px;
  border-radius: 8px;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.review-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  margin-right: 10px;
}

.review-info {
  flex: 1;
}

.review-user {
  font-size: 14px;
  color: #333;
  font-weight: 500;
  margin-bottom: 4px;
}

.review-rating {
  font-size: 12px;
}

.review-time {
  font-size: 12px;
  color: #999;
}

.review-content {
  font-size: 14px;
  color: #666;
  line-height: 1.5;
  margin-left: 46px;
}

.empty-reviews {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
  color: #999;
}

.empty-reviews .empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-reviews .empty-text {
  font-size: 14px;
}

.detail-actions {
  display: flex;
  gap: 12px;
  padding: 16px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  border-top: 1px solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
}

.action-btn.primary {
  background: #4CAF50;
  color: white;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 手机号样式 */
.detail-item.phone-item {
  cursor: pointer;
}

.phone-value {
  color: #409eff;
  font-weight: bold;
}
