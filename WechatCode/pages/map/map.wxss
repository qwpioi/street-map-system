/* ===== 地图页样式 ===== */

.map-container {
  height: 100vh;
  position: relative;
  background-color: var(--color-bg-page);
}

.full-map {
  width: 100%;
  height: 100%;
}

/* ===== 定位按钮 ===== */
.locate-btn {
  position: absolute;
  bottom: 200rpx;
  right: 30rpx;
  background-color: var(--color-bg-card);
  padding: 20rpx 30rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  z-index: 10;
  transition: transform var(--transition-fast);
}

.locate-btn-hover {
  background-color: var(--color-primary-bg);
  transform: scale(0.95);
}

.locate-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  margin-left: var(--space-xs);
  font-weight: 500;
}

/* ===== 摊位统计标签 ===== */
.map-stats {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  background-color: rgba(0, 0, 0, 0.75);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  z-index: 10;
  display: flex;
  align-items: center;
  backdrop-filter: blur(10rpx);
}

.stats-text {
  color: #fff;
  font-size: var(--font-size-sm);
  margin-left: var(--space-xs);
  font-weight: 500;
}
