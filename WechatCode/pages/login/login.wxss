.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFD100 0%, #FFD100 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-section {
  margin-top: 80rpx;
  text-align: center;
}

.logo {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.welcome-text {
  text-align: center;
  margin-bottom: 80rpx;
  margin-top: 40rpx;
}

.welcome-text text {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  display: block;
}

.sub-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  display: block;
}

.login-btn {
  width: 100%;
  background-color: #fff !important;
  color: #FFD100 !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  padding: 32rpx 0 !important;
  border-radius: 50rpx !important;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.15);
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.tips {
  margin-top: 80rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  text-align: center;
}

.link {
  color: #fff;
  font-weight: bold;
  padding: 4rpx 8rpx;
}

/* 隐私协议弹窗 */
.privacy-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.privacy-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.privacy-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 48rpx;
  text-align: left;
}

.privacy-link {
  color: #576B95;
  text-decoration: underline;
}

.privacy-btns {
  display: flex;
  gap: 24rpx;
}

.privacy-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.reject {
  background: #f5f5f5;
  color: #666;
}

.privacy-btn.agree {
  background: #FFD100;
  color: #fff;
}
