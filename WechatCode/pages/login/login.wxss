/* CSS 变量 */
page {
  --color-primary: #FFB300;
  --color-primary-light: #FFC940;
  --color-white: #fff;
  --color-text-dark: #333;
  --color-text-gray: #666;
  --color-text-light: rgba(255, 255, 255, 0.85);
  --color-link: #576B95;
  --radius-lg: 48rpx;
  --radius-md: 24rpx;
  --radius-pill: 50rpx;
  --shadow-btn: 0 12rpx 40rpx rgba(255, 179, 0, 0.35);
  --shadow-btn-hover: 0 6rpx 20rpx rgba(255, 179, 0, 0.25);
  --shadow-modal: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo 区域 */
.logo-section {
  margin-top: 80rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-white);
  display: block;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: var(--color-text-light);
}

/* 欢迎文字 */
.welcome-text {
  text-align: center;
  margin-bottom: 80rpx;
  margin-top: 40rpx;
}

.welcome-text text {
  font-size: 36rpx;
  color: var(--color-white);
  font-weight: bold;
  display: block;
}

.sub-text {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-top: 12rpx;
  display: block;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  background-color: var(--color-white) !important;
  color: var(--color-primary) !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  padding: 32rpx 0 !important;
  border-radius: var(--radius-pill) !important;
  box-shadow: var(--shadow-btn);
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.login-btn::after {
  border: none;
}

.login-btn-hover {
  transform: scale(0.97);
  box-shadow: var(--shadow-btn-hover);
  opacity: 0.9;
}

.btn-icon {
  margin-right: 12rpx;
}

/* 提示文字 */
.tips {
  margin-top: 80rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

.link {
  color: var(--color-white);
  font-weight: bold;
  padding: 4rpx 8rpx;
}

/* 隐私协议弹窗 */
.privacy-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.privacy-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: 56rpx 44rpx 44rpx;
  box-shadow: var(--shadow-modal);
}

.privacy-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--color-text-dark);
  text-align: center;
  margin-bottom: 28rpx;
}

.privacy-desc {
  font-size: 28rpx;
  color: var(--color-text-gray);
  line-height: 1.7;
  margin-bottom: 48rpx;
  text-align: left;
}

.privacy-link {
  color: var(--color-link);
  text-decoration: underline;
}

.privacy-btns {
  display: flex;
  gap: 24rpx;
}

.privacy-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: opacity 0.2s ease;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.reject {
  background: #f5f5f5;
  color: var(--color-text-gray);
}

.privacy-btn.agree {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: var(--color-white);
}
