<view class="login-container">
  <view class="logo-section">
    <text class="logo">🛒</text>
    <text class="app-name">地摊地图</text>
    <text class="app-desc">发现身边的特色摊位</text>
  </view>

  <view class="welcome-text">
    <text>欢迎使用地摊地图</text>
    <text class="sub-text">发现身边的美味摊位</text>
  </view>

  <button class="login-btn" type="primary" bindtap="wxLogin">
    <text class="btn-icon">💚</text>
    <text>微信一键登录</text>
  </button>

  <view class="tips">
    <text>登录即代表你同意</text>
    <text class="link" bindtap="goAgreement">《用户协议》</text>
    <text>和</text>
    <text class="link" bindtap="goPrivacy">《隐私政策》</text>
  </view>

  <!-- 隐私协议弹窗 -->
  <view class="privacy-modal" wx:if="{{showPrivacy}}">
    <view class="privacy-mask"></view>
    <view class="privacy-content">
      <view class="privacy-title">隐私保护提示</view>
      <view class="privacy-desc">
        <text>在使用地摊地图前，请仔细阅读并充分理解</text>
        <text class="privacy-link" bindtap="goAgreement">《用户协议》</text>
        <text>和</text>
        <text class="privacy-link" bindtap="goPrivacy">《隐私政策》</text>
        <text>。如同意请点击"同意"开始使用。</text>
      </view>
      <view class="privacy-btns">
        <button class="privacy-btn reject" bindtap="onPrivacyReject">拒绝</button>
        <button class="privacy-btn agree" bindtap="onPrivacyAgree">同意</button>
      </view>
    </view>
  </view>
</view>
