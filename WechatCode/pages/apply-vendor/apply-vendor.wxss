page {
  background-color: #f5f5f5;
}

.page-container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 0;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 卡片容器 */
.card {
  background: #fff;
  margin: 0 30rpx 40rpx;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

/* 表单项 */
.form-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: red;
}

/* 输入框 */
.input {
  width: 100%;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 1.2;
}
.input::placeholder {
  color: #999;
  line-height: 88rpx;
}

/* 文本域 */
.textarea {
  width: 100%;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
  box-sizing: border-box;
  min-height: 200rpx;
  line-height: 1.6;
}
.textarea::placeholder {
  color: #999;
}

/* 定位行 */
.location-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.flex-1 {
  flex: 1;
}
.btn-loc {
  background: #FFD100;
  color: white;
  font-size: 26rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  border: none;
  white-space: nowrap;
  line-height: 1.5;
}
.btn-loc::after {
  border: none;
}

/* 提交按钮 */
.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FFD100;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.3);
  margin-top: 60rpx;
}
.btn-submit::after {
  border: none;
}
