page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page-container {
  min-height: 100vh;
  background: #F5F5F5;
}

/* ========== 黄色渐变头部 ========== */
.vd-header {
  background: linear-gradient(180deg, #FFD100 0%, #FFC107 70%, #F5F5F5 100%);
  padding: 0 24rpx 32rpx;
}

.vd-back-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.vd-back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.vd-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.vd-status-pill.open { background: #E8F5E9; color: #2E7D32; }
.vd-status-pill.closed { background: #F5F5F5; color: #999; }

.vd-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

/* ========== 摊位信息卡片 ========== */
.vd-shop-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.vd-shop-top {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.vd-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.vd-shop-info { flex: 1; }

.vd-shop-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.vd-shop-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vd-rating-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.vd-star { font-size: 22rpx; color: #FFD100; }
.vd-score { font-size: 26rpx; font-weight: 700; color: #FF6633; }

.vd-review-link {
  font-size: 24rpx;
  color: #999;
}

.vd-fav-icon {
  font-size: 44rpx;
  padding: 8rpx;
  margin-left: auto;
}

/* ========== 信息网格 ========== */
.vd-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.vd-info-cell {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.vd-info-cell.full {
  grid-column: 1 / -1;
}

.vd-ic { font-size: 24rpx; flex-shrink: 0; }
.vd-iv { color: #1A1A1A; font-weight: 500; }
.phone-val { color: #FF6633; }

.vd-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.vd-tag {
  font-size: 22rpx;
  color: #FF6633;
  background: #FFF3E0;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

/* ========== 通用 Section ========== */
.vd-section {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.vd-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.vd-badge {
  font-size: 20rpx;
  background: #FF6633;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.vd-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.vd-more {
  font-size: 24rpx;
  color: #FF6633;
}

/* ========== 商品列表 ========== */
.vd-product {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.vd-product:last-child { border-bottom: none; }

.vd-product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #eee;
  flex-shrink: 0;
}

.vd-product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.vd-product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.vd-product-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.vd-product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vd-product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6633;
}

.vd-yen {
  font-size: 22rpx;
}

/* ========== 评价列表 ========== */
.vd-review {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.vd-review:last-child { border-bottom: none; }

.vd-review-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.vd-review-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.vd-review-user {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.vd-review-stars {
  display: flex;
  gap: 2rpx;
  font-size: 20rpx;
}

.vd-review-stars .filled { color: #FFD100; }
.vd-review-stars .empty { color: #DDD; }

.vd-review-time {
  font-size: 20rpx;
  color: #CCC;
}

.vd-review-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-left: 62rpx;
}

/* ========== 空状态 ========== */
.vd-empty {
  text-align: center;
}

.vd-empty-text {
  font-size: 28rpx;
  color: #999;
  padding: 40rpx 0;
}

/* ========== 底部操作栏 ========== */
.bottom-spacer {
  height: 130rpx;
}

.vd-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.vd-bottom-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 0 16rpx;
}

.vd-bi { font-size: 36rpx; }
.vd-bt { font-size: 18rpx; color: #999; }

.vd-bottom-actions {
  flex: 1;
  display: flex;
  gap: 12rpx;
  margin-left: 16rpx;
}

.vd-btn-secondary {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  border: 1rpx solid #FFD100;
  background: #FFFDE7;
  color: #FF6633;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.vd-btn-primary {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  border: none;
  background: linear-gradient(135deg, #FFD100, #FFC107);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255,209,0,0.3);
  padding: 0;
  margin: 0;
}

.vd-btn-secondary::after,
.vd-btn-primary::after { border: none; }

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  font-size: 28rpx;
  color: #999;
}
