page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.page-container {
  padding: 20rpx 0;
  min-height: 100vh;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 头部信息 */
.header-top {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.avatar-gradient {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 60rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.rating-row {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fav-icon {
  margin-left: auto;
  font-size: 44rpx;
  padding: 10rpx;
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
}

.status {
  font-weight: bold;
}

.status.open {
  color: #4CAF50;
}

.status.closed {
  color: #999;
}

.phone {
  color: #4CAF50;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #ff6b00;
  background-color: rgba(255, 107, 0, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 章节标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #333;
}

.section-title-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.more {
  color: #4CAF50;
  font-size: 26rpx;
}

/* 商品列表 */
.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
}

.p-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #eee;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.p-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.p-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.p-desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.p-price {
  color: #f44336;
  font-size: 32rpx;
  font-weight: bold;
}

/* 评价列表 */
.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
}

.r-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.r-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eee;
}

.r-info {
  flex: 1;
}

.r-name {
  font-size: 26rpx;
  color: #666;
}

.r-rating {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.r-score {
  color: #f37b1d;
  font-size: 24rpx;
}

.r-time {
  font-size: 22rpx;
  color: #999;
}

.r-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 空状态 */
.empty-card {
  text-align: center;
}

.empty {
  color: #999;
  padding: 40rpx 0;
  font-size: 28rpx;
}

/* 底部操作栏 */
.bottom-spacer {
  height: 120rpx;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 24rpx;
  z-index: 100;
}

.btn-action {
  flex: 1;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
}

.btn-action.primary {
  background: #4CAF50;
  color: white;
}

.btn-action.secondary {
  background: #f5f5f5;
  color: #333;
}

.btn-action::after {
  border: none;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  font-size: 28rpx;
  color: #999;
}
