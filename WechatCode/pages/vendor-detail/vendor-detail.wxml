<view class="page-container" wx:if="{{!loading && vendor}}">

  <!-- 卡片 1：摊位基础信息 -->
  <view class="card">
    <view class="header-top">
      <view class="avatar-gradient">
        <text class="avatar-icon">🍜</text>
      </view>
      <view class="info">
        <text class="name">{{vendor.stallName}}</text>
        <view class="rating-row">
          <text class="stars" wx:if="{{averageRating > 0}}">⭐ {{averageRating.toFixed(1)}}</text>
          <text class="stars" wx:else>暂无评分</text>
          <text class="count" bindtap="viewAllReviews">{{reviewCount}}条评价</text>
        </view>
      </view>
      <view class="fav-icon" bindtap="toggleFavorite">
        <text wx:if="{{isFavorite}}">❤️</text>
        <text wx:else>🤍</text>
      </view>
    </view>

    <view class="info-list">
      <view class="info-item" wx:if="{{vendor.address}}">
        <text class="label">📍 地址</text>
        <text class="value">{{vendor.address}}</text>
      </view>
      <view class="info-item" wx:if="{{vendor.phone}}" bindtap="callPhone">
        <text class="label">📞 电话</text>
        <text class="value phone">{{vendor.phone}}</text>
      </view>
      <view class="info-item" wx:if="{{vendor.hotProductsArray.length > 0}}">
        <text class="label">🔥 主打</text>
        <view class="tags">
          <text class="tag" wx:for="{{vendor.hotProductsArray}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="info-item">
        <text class="label">⏰ 状态</text>
        <text class="value status {{vendor.status === 1 ? 'open' : 'closed'}}">
          {{vendor.status === 1 ? '营业中' : '已收摊'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 卡片 2：商品列表 -->
  <view class="card" wx:if="{{products.length > 0}}">
    <view class="section-title">🥘 全部商品 ({{products.length}})</view>
    <view class="product-list">
      <view class="product-item" wx:for="{{products}}" wx:key="id">
        <image class="p-img" src="{{item.imageUrl || 'https://via.placeholder.com/100'}}" mode="aspectFill" />
        <view class="p-info">
          <text class="p-name">{{item.name}}</text>
          <text class="p-desc" wx:if="{{item.description}}">{{item.description}}</text>
          <text class="p-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="card empty-card" wx:else>
    <view class="empty">🍽️ 暂无上架商品</view>
  </view>

  <!-- 卡片 3：最新评价 -->
  <view class="card" wx:if="{{reviews.length > 0}}">
    <view class="section-title-with-action">
      <text>💬 最新评价</text>
      <text class="more" bindtap="viewAllReviews" wx:if="{{reviewCount > 5}}">查看全部 ></text>
    </view>
    <view class="review-list">
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="r-header">
          <image class="r-avatar" src="{{item.userAvatar || 'https://via.placeholder.com/50'}}" mode="aspectFill" />
          <view class="r-info">
            <text class="r-name">{{item.userName || '匿名用户'}}</text>
            <view class="r-rating">
              <text class="r-score">⭐{{item.rating}}</text>
              <text class="r-time">{{item.createTime}}</text>
            </view>
          </view>
        </view>
        <text class="r-content" wx:if="{{item.content}}">{{item.content}}</text>
      </view>
    </view>
  </view>
  <view class="card empty-card" wx:else>
    <view class="empty">😢 暂无评价，快来成为第一个评价的人吧！</view>
  </view>

  <!-- 底部占位，防止内容被固定栏遮挡 -->
  <view class="bottom-spacer"></view>

  <!-- 底部固定操作栏 -->
  <view class="bottom-action-bar">
    <button class="btn-action secondary" bindtap="addReview">📝 发表评价</button>
    <button class="btn-action primary" bindtap="navigateTo">🧭 导航前往</button>
  </view>

</view>

<!-- 加载状态 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
