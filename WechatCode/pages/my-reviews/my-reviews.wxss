.my-reviews-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-home-btn {
  width: 300rpx;
  background-color: #4CAF50;
  color: #fff;
  font-size: 28rpx;
  border-radius: 30rpx;
  border: none;
}

.go-home-btn::after {
  border: none;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #fff;
  margin: 30rpx;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #4CAF50;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #f0f0f0;
}

.stat-stars {
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* 评价列表 */
.review-list {
  padding: 0 30rpx;
}

.review-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  position: relative;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.vendor-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.card-arrow {
  font-size: 28rpx;
  color: #ccc;
  margin-left: 16rpx;
  margin-right: 16rpx;
}

.delete-btn {
  font-size: 24rpx;
  color: #e74c3c;
  padding: 8rpx 20rpx;
  border: 2rpx solid #e74c3c;
  border-radius: 30rpx;
  background: transparent;
}

.card-rating {
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.card-footer {
  margin-top: 16rpx;
}

.card-time {
  font-size: 22rpx;
  color: #999;
}
