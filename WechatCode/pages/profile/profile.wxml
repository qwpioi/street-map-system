<view class="profile-container">
  <!-- 用户头部（黄色渐变） -->
  <view class="profile-header">
    <view class="profile-user-row">
      <image wx:if="{{isLoggedIn && (userInfo.avatarUrl || userInfo.avatar)}}" class="profile-avatar" src="{{userInfo.avatarUrl || userInfo.avatar}}" mode="aspectFill"></image>
      <view wx:else class="profile-avatar default-avatar">
        <text class="avatar-emoji">😊</text>
      </view>
      <view class="profile-user-info">
        <text class="profile-nickname">{{isLoggedIn ? (userInfo.nickName || userInfo.username || '摊友') : '未登录'}}</text>
        <text class="profile-desc">{{isLoggedIn ? '探索城市味道，发现身边好摊' : '登录后可收藏摊位、发布评论'}}</text>
      </view>
    </view>
  </view>

  <!-- 数据统计卡片 -->
  <view class="stats-card" wx:if="{{isLoggedIn}}">
    <view class="stat-item" bindtap="goFavorite">
      <text class="stat-num">⭐</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item" bindtap="goComments">
      <text class="stat-num">💬</text>
      <text class="stat-label">评价</text>
    </view>
    <view class="stat-item" bindtap="goVendor">
      <text class="stat-num">🏪</text>
      <text class="stat-label">摊位</text>
    </view>
    <view class="stat-item" bindtap="goBecomeVendor">
      <text class="stat-num">📝</text>
      <text class="stat-label">成为摊主</text>
    </view>
  </view>

  <!-- 未登录按钮 -->
  <view class="login-section" wx:if="{{!isLoggedIn}}">
    <button class="login-btn" bindtap="goLogin">立即登录</button>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goFavorite">
      <view class="pmi-icon orange">⭐</view>
      <text class="pmi-text">我的收藏</text>
      <text class="pmi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goVendor">
      <view class="pmi-icon green">🏪</view>
      <text class="pmi-text">我的摊位</text>
      <text class="pmi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goComments">
      <view class="pmi-icon blue">💬</view>
      <text class="pmi-text">我的评价</text>
      <text class="pmi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goBecomeVendor">
      <view class="pmi-icon purple">📝</view>
      <text class="pmi-text">成为摊主</text>
      <text class="pmi-arrow">›</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goSettings">
      <view class="pmi-icon gray">⚙️</view>
      <text class="pmi-text">设置</text>
      <text class="pmi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <view class="pmi-icon gray">ℹ️</view>
      <text class="pmi-text">关于我们</text>
      <text class="pmi-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
