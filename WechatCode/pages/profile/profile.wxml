<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <image wx:if="{{isLoggedIn && (userInfo.avatarUrl || userInfo.avatar)}}" class="avatar" src="{{userInfo.avatarUrl || userInfo.avatar}}" mode="aspectFill"></image>
      <view wx:if="{{isLoggedIn && !(userInfo.avatarUrl || userInfo.avatar)}}" class="avatar" style="background-color: #e0e0e0; display: flex; align-items: center; justify-content: center;">
        <text style="font-size: 40rpx; color: #999;">👤</text>
      </view>
      <view wx:else class="avatar" style="background-color: #e0e0e0;"></view>
      <view class="user-info">
        <text class="nickname">{{isLoggedIn ? (userInfo.nickName || userInfo.username) : '未登录'}}</text>
        <text class="user-id">{{isLoggedIn ? '欢迎使用地摊地图' : '登录后可收藏摊位、发布评论'}}</text>
      </view>
    </view>
    <button class="login-btn" wx:if="{{!isLoggedIn}}" bindtap="goLogin">立即登录</button>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goFavorite">
      <text class="menu-icon">⭐</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goVendor">
      <text class="menu-icon">🏪</text>
      <text class="menu-text">我的摊位</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goComments">
      <text class="menu-icon">💬</text>
      <text class="menu-text">我的评价</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goBecomeVendor">
      <text class="menu-icon">📝</text>
      <text class="menu-text">成为摊主</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
