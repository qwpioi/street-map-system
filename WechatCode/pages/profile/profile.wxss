page {
  --color-primary: #FFD100;
  --color-primary-dark: #FFC107;
  --color-accent: #FF6633;
  --color-danger: #FF3366;
  --color-bg: #F5F5F5;
  --color-text: #1A1A1A;
  --color-text-secondary: #666;
  --color-text-muted: #999;
  --color-border: #F5F5F5;
  --radius-card: 20rpx;
  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-menu: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);

  background: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

view, text, image, button {
  box-sizing: border-box;
}

.profile-container {
  width: 750rpx;
  min-height: 100vh;
  background: var(--color-bg);
}

/* ========== 用户头部 ========== */
.profile-header {
  width: 750rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 50%, #FFB300 100%);
  padding: 40rpx 30rpx 56rpx;
  position: relative;
}

.profile-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 20rpx;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.03));
}

.profile-user-row {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.default-avatar {
  background: rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-user-info {
  flex: 1;
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 6rpx;
}

.profile-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ========== 统计卡片 ========== */
.stats-card {
  display: flex;
  background: #fff;
  margin: -28rpx 30rpx 0;
  border-radius: var(--radius-card);
  padding: 28rpx 0;
  box-shadow: var(--shadow-card);
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* ========== 登录按钮 ========== */
.login-section {
  padding: 24rpx 30rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 1;
}

.login-btn {
  width: 690rpx;
  background: #fff !important;
  color: var(--color-accent) !important;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: var(--radius-card);
  border: 2rpx solid var(--color-primary) !important;
  box-shadow: var(--shadow-card);
}

.login-btn::after { border: none; }

/* ========== 功能菜单 ========== */
.menu-section {
  width: 690rpx;
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-menu);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background-color: #F9F9F9;
}

.pmi-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.pmi-icon.orange { background: #FFF3E0; }
.pmi-icon.green { background: #E8F5E9; }
.pmi-icon.blue { background: #E3F2FD; }
.pmi-icon.purple { background: #F3E5F5; }
.pmi-icon.gray { background: #ECEFF1; }

.pmi-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* ========== 退出登录 ========== */
.logout-section {
  padding: 40rpx 30rpx;
}

.logout-btn {
  width: 690rpx;
  background: #fff !important;
  color: var(--color-danger) !important;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: var(--radius-card);
  border: 2rpx solid var(--color-danger) !important;
}

.logout-btn::after { border: none; }
