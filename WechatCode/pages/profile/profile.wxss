.profile-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.user-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999;
}

.login-btn {
  width: 100%;
  background-color: #4CAF50 !important;
  color: #fff !important;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 30rpx;
  border: none !important;
}

.login-btn::after {
  border: none;
}

.menu-section {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #999;
}

.logout-section {
  margin-top: 60rpx;
}

.logout-btn {
  width: 100%;
  background-color: #fff !important;
  color: #ff4444 !important;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid #ff4444 !important;
}

.logout-btn::after {
  border: none;
}
