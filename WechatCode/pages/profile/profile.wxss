page {
  background: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.profile-container {
  min-height: 100vh;
  background: #F5F5F5;
}

/* ========== 用户头部 ========== */
.profile-header {
  background: linear-gradient(180deg, #FFD100 0%, #FFC107 100%);
  padding: 40rpx 32rpx 56rpx;
}

.profile-user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.8);
  flex-shrink: 0;
}

.default-avatar {
  background: rgba(255,255,255,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 48rpx;
}

.profile-user-info {
  flex: 1;
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 6rpx;
}

.profile-desc {
  font-size: 24rpx;
  color: #666;
}

/* ========== 统计卡片 ========== */
.stats-card {
  display: flex;
  background: #fff;
  margin: -28rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 36rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* ========== 登录按钮 ========== */
.login-section {
  padding: 24rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 1;
}

.login-btn {
  width: 100%;
  background: #fff !important;
  color: #FF6633 !important;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid #FFD100 !important;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.login-btn::after { border: none; }

/* ========== 功能菜单 ========== */
.menu-section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.pmi-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.pmi-icon.orange { background: #FFF3E0; }
.pmi-icon.green { background: #E8F5E9; }
.pmi-icon.blue { background: #E3F2FD; }
.pmi-icon.purple { background: #F3E5F5; }
.pmi-icon.gray { background: #ECEFF1; }

.pmi-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.pmi-arrow {
  font-size: 32rpx;
  color: #CCC;
}

/* ========== 退出登录 ========== */
.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  width: 100%;
  background: #fff !important;
  color: #FF3366 !important;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid #FF3366 !important;
}

.logout-btn::after { border: none; }
