/* 页面容器（隐藏原页面内容） */
page {
  background-color: transparent;
}

/* 背景遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* 半屏弹窗容器 */
.review-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 65vh;
  display: flex;
  flex-direction: column;
  pointer-events: none;
}

.review-modal.show {
  transform: translateY(0);
  pointer-events: auto;
}

/* 顶部拖动条 */
.modal-drag-bar {
  padding: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.drag-indicator {
  width: 80rpx;
  height: 8rpx;
  background-color: #e0e0e0;
  border-radius: 4rpx;
}

/* 标题栏 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

/* 平均评分 */
.modal-average {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  flex-shrink: 0;
}

.average-score {
  font-size: 80rpx;
  font-weight: bold;
  line-height: 1;
}

.average-stars {
  font-size: 32rpx;
  margin: 10rpx 0;
}

.average-text {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* 评价列表滚动区域 */
.review-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0;
}

.review-list {
  min-height: 300rpx;
}

.review-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.review-user {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.review-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.delete-btn {
  font-size: 24rpx;
  color: #e74c3c;
  padding: 4rpx 12rpx;
}

.review-rating {
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.review-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
  color: #999;
  font-size: 28rpx;
}

/* 底部按钮 */
.modal-footer {
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.add-review-btn {
  width: 100%;
  background-color: #4CAF50 !important;
  color: #fff !important;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 30rpx;
  border: none !important;
}

.add-review-btn::after {
  border: none;
}
