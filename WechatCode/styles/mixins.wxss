/**
 * 通用样式 Mixins
 * 提供常用的样式组合，减少重复代码
 */

/* Flex 布局 - 水平居中 */
.flex-center-h {
  display: flex;
  justify-content: center;
}

/* Flex 布局 - 垂直居中 */
.flex-center-v {
  display: flex;
  align-items: center;
}

/* Flex 布局 - 完全居中 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Flex 布局 - 两端对齐 */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Flex 布局 - 等分布局 */
.flex-equal {
  display: flex;
}
.flex-equal > view {
  flex: 1;
}

/* Flex 布局 - 纵向排列 */
.flex-column {
  display: flex;
  flex-direction: column;
}

/* 文本截断 - 单行 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 文本截断 - 多行 */
.text-ellipsis-multi {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 安全区适配 - 底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom); /* iOS < 11.2 */
  padding-bottom: env(safe-area-inset-bottom);      /* iOS >= 11.2 */
}

/* 点击态 */
.hover-opacity {
  opacity: 0.7;
}

.hover-scale {
  transform: scale(0.98);
}

/* 卡片样式 */
.card-base {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

/* 主按钮 */
.btn-primary {
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-full);
  font-weight: 600;
}

/* 次要按钮 */
.btn-secondary {
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  border-radius: var(--radius-full);
  font-weight: 600;
}

/* 加载动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
